import Lean.Util.CollectAxioms
import Mathlib.RingTheory.DiscreteValuationRing.Basic
import Mathlib.RingTheory.LocalRing.RingHom.Basic
import PrimalitySheafVerification.ManuscriptAudit.ReducedFibreRamification

/-! A parameter in a discrete valuation ring generates its maximal
ideal when its image cuts a reduced fibre on a dominating local chart. -/

namespace ManuscriptAudit.DVRParameterReduction

variable {S B : Type*} [CommRing S] [IsDomain S] [IsDiscreteValuationRing S]
  [CommRing B] [IsLocalRing B] (f : S →+* B) [IsLocalHom f]

/-- The maximum ideal is already generated by the unramified parameter. -/
theorem maximalIdeal_eq_span_of_reduced_image (s : S)
    (hs : s ∈ IsLocalRing.maximalIdeal S) (hfs : f s ≠ 0)
    [IsReduced (B ⧸ Ideal.span ({f s} : Set B))] :
    IsLocalRing.maximalIdeal S = Ideal.span ({s} : Set S) := by
  have hs₀ : s ≠ 0 := fun h ↦ hfs (by rw [h, map_zero])
  obtain ⟨π, hπ⟩ := IsDiscreteValuationRing.exists_irreducible S
  obtain ⟨n, u, hu⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hs₀ hπ
  have hn : 0 < n := by
    apply Nat.pos_of_ne_zero
    intro h
    have he : s = (u : S) := by simpa only [h, pow_zero, mul_one] using hu
    exact hs (he.symm ▸ u.isUnit)
  have hπB : f π ∈ IsLocalRing.maximalIdeal B :=
    IsLocalRing.map_nonunit f π hπ.not_isUnit
  let u' : Bˣ := Units.map f.toMonoidHom u
  have hf : f s = (f π)^n * (u' : B) := by
    rw [hu, map_mul, map_pow]
    exact mul_comm _ _
  have hn₁ := ReducedFibreRamification.exponent_eq_one (f s) (f π) u' n hn hfs hπB hf
  have hAssoc : Associated π s :=
    ⟨u, by simpa only [hn₁, pow_one, mul_comm] using hu.symm⟩
  exact (IsDiscreteValuationRing.irreducible_iff_uniformizer _).mp (hAssoc.irreducible hπ)

end ManuscriptAudit.DVRParameterReduction

open Lean Elab Command in
run_cmd do
  let name := ``ManuscriptAudit.DVRParameterReduction.maximalIdeal_eq_span_of_reduced_image
  let dependencies ← collectAxioms name
  let allowed : List Name := [``propext, ``Classical.choice, ``Quot.sound]
  let unexpected := dependencies.filter fun axiomName => !allowed.contains axiomName
  unless unexpected.isEmpty do
    throwError m!"{name} depends on unexpected axioms {unexpected}"
  logInfo m!"{name} uses {dependencies}"

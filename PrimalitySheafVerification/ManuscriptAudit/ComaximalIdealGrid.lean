import Lean.Util.CollectAxioms
import Mathlib.RingTheory.Ideal.Operations

/-! Two finite transverse families of comaximal ideals give the corresponding product of point ideals. -/

namespace ManuscriptAudit.ComaximalIdealGrid

open scoped BigOperators

noncomputable section

variable {R : Type*} [CommRing R]

private theorem sup_mul_sup_of_coprime (I J K : Ideal R) (h : I ⊔ J = ⊤) :
    (I ⊔ K) * (J ⊔ K) = I * J ⊔ K := by
  have hPair : I * K ⊔ J * K = K := by
    rw [← Ideal.sup_mul, h, Ideal.top_mul]
  calc
    _ = I * J ⊔ (I * K ⊔ J * K) ⊔ K * K := by
      rw [Ideal.sup_mul, Ideal.mul_sup, Ideal.mul_sup, mul_comm K J]
      ac_rfl
    _ = _ := by
      rw [hPair, sup_assoc, sup_eq_left.mpr Ideal.mul_le_left]

/-- Adjoining one ideal to each factor distributes over a pairwise comaximal product. -/
theorem prod_sup_eq (s : Finset ι) (I : ι → Ideal R) (K : Ideal R)
    (h : ∀ i ∈ s, ∀ j ∈ s, i ≠ j → I i ⊔ I j = ⊤) :
    (∏ i ∈ s, I i ⊔ K) = (∏ i ∈ s, I i) ⊔ K := by
  classical
  revert h
  induction s using Finset.induction_on with
  | empty =>
    intro h
    simp [Ideal.one_eq_top]
  | @insert i s hi ih =>
    intro h
    have hs : ∀ a ∈ s, ∀ b ∈ s, a ≠ b → I a ⊔ I b = ⊤ :=
      fun a ha b hb hab => h a (Finset.mem_insert_of_mem ha) b (Finset.mem_insert_of_mem hb) hab
    have hc : I i ⊔ (∏ j ∈ s, I j) = ⊤ :=
      Ideal.sup_prod_eq_top fun j hj =>
        h i (Finset.mem_insert_self i s) j (Finset.mem_insert_of_mem hj) (fun hij => hi (hij.symm ▸ hj))
    rw [Finset.prod_insert hi, Finset.prod_insert hi, ih hs,
      sup_mul_sup_of_coprime _ _ _ hc]

/-- The ideal generated by the two products is the product of the pairwise point ideals. -/
theorem prod_prod_sup_eq (s : Finset ι) (t : Finset κ) (I : ι → Ideal R) (J : κ → Ideal R)
    (hI : ∀ a ∈ s, ∀ b ∈ s, a ≠ b → I a ⊔ I b = ⊤)
    (hJ : ∀ a ∈ t, ∀ b ∈ t, a ≠ b → J a ⊔ J b = ⊤) :
    (∏ i ∈ s, ∏ j ∈ t, I i ⊔ J j) = (∏ i ∈ s, I i) ⊔ (∏ j ∈ t, J j) := by
  calc
    _ = ∏ i ∈ s, I i ⊔ (∏ j ∈ t, J j) := by
      apply Finset.prod_congr rfl
      intro i _
      simpa only [sup_comm] using prod_sup_eq t J (I i) hJ
    _ = _ := prod_sup_eq s I _ hI

end
end ManuscriptAudit.ComaximalIdealGrid

open Lean Elab Command in
run_cmd do
  let allowed : List Name := [``propext, ``Classical.choice, ``Quot.sound]
  for name in [
      ``ManuscriptAudit.ComaximalIdealGrid.prod_sup_eq,
      ``ManuscriptAudit.ComaximalIdealGrid.prod_prod_sup_eq] do
    let ax ← collectAxioms name
    let bad := ax.filter fun x => !allowed.contains x
    unless bad.isEmpty do
      throwError m!"{name} depends on unexpected axioms {bad}"
    logInfo m!"{name} uses {ax}"

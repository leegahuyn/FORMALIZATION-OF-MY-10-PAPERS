import Lean.Util.CollectAxioms
import PrimalitySheafVerification.ManuscriptAudit.AffineLineNativeResidueHTwo
import PrimalitySheafVerification.ManuscriptAudit.CuspProetaleCohomologyEquivalence
import PrimalitySheafVerification.ManuscriptAudit.CuspNativeAdicHTwoRangeCriterion
import PrimalitySheafVerification.ManuscriptAudit.CuspNativeAdicHTwoReductionDetection
import PrimalitySheafVerification.ManuscriptAudit.CuspNativeAdicHTwoLinear
import PrimalitySheafVerification.ManuscriptAudit.CuspNativeCompactAdicHTwoAmbient

/-! In positive characteristic the actual affine normalization
and finite reductions identify both compact cusp groups in degree two. -/

namespace ManuscriptAudit.CuspNativeAdicHTwoPositiveCharacteristic

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits
open CuspProperCompactification (projectiveCusp affineCusp affineOpen)
open CuspProperYChart (lineOpen)
open CuspNativeProetaleHTwoLower (overlapOpen fstLeg sndLeg overlap cover)
open CuspNativeAdicHTwoReduction (residueInclusion)
open CuspNativeAdicHTwoReductionDetection (reduction_injective)
open CuspNativeAdicHTwoLower (adicInclusion)
open ProetaleAdicHOneDetection (finiteCoefficient)
open ProetaleClosedOpenRestriction (restrictionFunctionsIso)
open ProetaleCohomologyIso (cohomologyIso)
open ProetaleConstantRestriction (constant)
open OpenProetaleExtension (restriction)
open ProetaleMayerVietorisConnecting (connecting_surjective)

noncomputable section

set_option backward.defeqAttrib.useBackward true
set_option backward.isDefEq.respectTransparency false

variable (K : Type) [Field K] [IsAlgClosed K]
  (p ℓ : ℕ) [hp : Fact p.Prime] [hchar : CharP K p] [Fact ℓ.Prime] [NeZero (ℓ : K)]

private abbrev A := AddCommGrpCat.{1}
private abbrev X := projectiveCusp K
private abbrev j := affineOpen K
private abbrev k := lineOpen K
private abbrev l := overlapOpen K
private abbrev V := Spec (CommRingCat.of (Polynomial K))
private abbrev W := affineCusp K

local instance residueTopology (d : ℕ) : TopologicalSpace (ZMod d) := ⊥
local instance residueDiscrete (d : ℕ) : DiscreteTopology (ZMod d) := ⟨rfl⟩
local instance cast_pow_neZero (n : ℕ) : NeZero ((ℓ ^ n : ℕ) : K) :=
  ⟨by rw [Nat.cast_pow]; exact pow_ne_zero n (NeZero.ne (ℓ : K))⟩

include p hp hchar in
set_option maxHeartbeats 6400000 in
/-- The actual native Laurent boundary reaches every finite degree-two class. -/
theorem residueInclusion_surjective (n : ℕ) : Function.Surjective (residueInclusion K ℓ n) := by
  let d := ℓ ^ n
  let r := ZMod d
  letI : Subsingleton (Sheaf.H (finiteCoefficient (V K) ℓ n) 2) :=
    AffineLineNativeResidueHTwo.native_residue_HTwo_subsingleton K ℓ n
  let e := cohomologyIso (X := V K) (ProetaleDiscreteConstant.nativeResidueIso (V K) ℓ n) 2
  letI : Subsingleton (Sheaf.H (constant (V K) r) 2) := e.injective.subsingleton
  let t := CuspProetaleCohomologyEquivalence.cyclicEquiv K p d 2
  letI : Subsingleton (Sheaf.H (constant (W K) r) 2) := t.injective.subsingleton
  let a := (cohomologyIso (X := W K) (restrictionFunctionsIso (j K) r) 2).trans
    (cohomologyIso (X := W K) (ProetaleDiscreteConstant.nativeResidueIso (W K) ℓ n).symm 2)
  let b := (cohomologyIso (X := V K) (restrictionFunctionsIso (k K) r) 2).trans
    (cohomologyIso (X := V K) (ProetaleDiscreteConstant.nativeResidueIso (V K) ℓ n).symm 2)
  unfold residueInclusion
  exact (connecting_surjective (j K) (k K) (l K) (fstLeg K) (sndLeg K) (overlap K) (cover K)
    (finiteCoefficient (X K) ℓ n) 1 a.injective.subsingleton b.injective.subsingleton).comp
      (AddEquiv.surjective _)

include p hp hchar in
/-- Finite residue detection proves surjectivity of the actual integral class. -/
theorem adicInclusion_surjective : Function.Surjective (adicInclusion K ℓ) :=
  CuspNativeAdicHTwoRangeCriterion.surjective_of_finite K ℓ (reduction_injective K ℓ)
    (residueInclusion_surjective K p ℓ)

include p hp hchar in
/-- The proper cusp's native degree-two adic cohomology is free of rank one. -/
def properLinearEquiv : ℤ_[ℓ] ≃ₗ[ℤ_[ℓ]] ((X K).EllAdicCohomology ℓ 2) :=
  LinearEquiv.ofBijective (CuspNativeAdicHTwoLinear.adicLinearInclusion K ℓ)
    ⟨CuspNativeAdicHTwoLinear.adicLinearInclusion_injective K ℓ, adicInclusion_surjective K p ℓ⟩

include p hp hchar in
/-- The actual native compact group of the affine cusp is generated by the Laurent class. -/
def affineCompactEquiv : ℤ_[ℓ] ≃+ CuspNativeCompactAffineAdicHTwoLower.compactHTwo K ℓ :=
  AddEquiv.ofBijective (CuspNativeCompactAffineAdicHTwoLower.inclusion K ℓ)
    ⟨CuspNativeCompactAffineAdicHTwoLower.inclusion_injective K ℓ,
      (CuspNativeCompactAdicHTwoAmbient.compact_inclusions_surjective K ℓ
        (adicInclusion_surjective K p ℓ)).1⟩

include p hp hchar in
/-- The actual native compact group of the smooth cusp locus has the same generator. -/
def smoothCompactEquiv : ℤ_[ℓ] ≃+ CuspNativeCompactSmoothAdicHTwoLower.compactHTwo K ℓ :=
  AddEquiv.ofBijective (CuspNativeCompactSmoothAdicHTwoLower.inclusion K ℓ)
    ⟨CuspNativeCompactSmoothAdicHTwoLower.inclusion_injective K ℓ,
      (CuspNativeCompactAdicHTwoAmbient.compact_inclusions_surjective K ℓ
        (adicInclusion_surjective K p ℓ)).2⟩

end
end ManuscriptAudit.CuspNativeAdicHTwoPositiveCharacteristic

open Lean Elab Command in
run_cmd do
  let allowed : List Name := [``propext, ``Classical.choice, ``Quot.sound]
  for name in [``ManuscriptAudit.CuspNativeAdicHTwoPositiveCharacteristic.properLinearEquiv,
      ``ManuscriptAudit.CuspNativeAdicHTwoPositiveCharacteristic.affineCompactEquiv,
      ``ManuscriptAudit.CuspNativeAdicHTwoPositiveCharacteristic.smoothCompactEquiv] do
    let dependencies ← collectAxioms name
    let unexpected := dependencies.filter fun axiomName => !allowed.contains axiomName
    unless unexpected.isEmpty do
      throwError m!"{name} depends on unexpected axioms {unexpected}"
    logInfo m!"{name} uses {dependencies}"

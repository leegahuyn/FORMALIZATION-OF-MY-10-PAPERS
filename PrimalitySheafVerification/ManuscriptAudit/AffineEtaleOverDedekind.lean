import Lean.Util.CollectAxioms
import Mathlib.RingTheory.DedekindDomain.Dvr
import Mathlib.RingTheory.Etale.Basic
import Mathlib.RingTheory.Unramified.LocalRing

/-! Integral affine étale charts over any Dedekind domain are themselves
Dedekind. The maximal ideal of each nonzero local chart is generated by
the image of the maximal ideal in the actual base localization. -/

namespace ManuscriptAudit.AffineEtaleOverDedekind

open IsLocalRing

noncomputable section

variable (A B : Type*) [CommRing A] [CommRing B]
variable [IsDedekindDomain A] [IsDomain B] [Algebra A B] [Algebra.Etale A B]

/-- The true affine coordinate ring of an integral étale chart over a
Dedekind domain is a Dedekind domain without any global PID assumption. -/
theorem isDedekindDomain : IsDedekindDomain B := by
  letI hNoeth : IsNoetherianRing B := Algebra.FiniteType.isNoetherianRing A B
  have hDvr : IsDedekindDomainDvr B := by
    refine { toIsNoetherian := hNoeth, is_dvr_at_nonzero_prime := ?_ }
    intro q hq hq'
    letI : q.IsPrime := hq'
    let p := q.under A
    letI : p.IsPrime := hq'.under A
    letI : q.LiesOver p := ⟨rfl⟩
    letI := Localization.AtPrime.algebraOfLiesOver p q
    let L := Localization.AtPrime p
    let M := Localization.AtPrime q
    have hMap : p.map (algebraMap A M) = maximalIdeal M :=
      ((Algebra.isUnramifiedAt_iff_map_eq A p q).mp
        (inferInstance : Algebra.IsUnramifiedAt A q)).2
    have hPrincipal : (maximalIdeal M).IsPrincipal := by
      by_cases hp : p = ⊥
      · rw [← hMap, hp, Ideal.map_bot]
        infer_instance
      · letI : IsDiscreteValuationRing L :=
          IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain A hp L
        have hL : (maximalIdeal L).IsPrincipal := inferInstance
        have hTower : IsScalarTower A L M := inferInstance
        letI : IsScalarTower A L M := hTower
        have he : (maximalIdeal L).map (algebraMap L M) = p.map (algebraMap A M) := by
          rw [← Localization.AtPrime.map_eq_maximalIdeal p, Ideal.map_map,
            ← IsScalarTower.algebraMap_eq A L M]
        rw [← hMap, ← he]
        exact Submodule.IsPrincipal.map_ringHom (algebraMap L M) hL
    exact ((IsDiscreteValuationRing.TFAE M (IsLocalization.AtPrime.not_isField B hq M)).out 4 0).mp
      hPrincipal
  letI := hDvr
  infer_instance

end

end ManuscriptAudit.AffineEtaleOverDedekind

open Lean Elab Command in
run_cmd do
  let name := ``ManuscriptAudit.AffineEtaleOverDedekind.isDedekindDomain
  let ax ← collectAxioms name
  let allowed : List Name := [``propext, ``Classical.choice, ``Quot.sound]
  let bad := ax.filter fun n => !allowed.contains n
  unless bad.isEmpty do
    throwError m!"{name} depends on unexpected axioms {bad}"
  logInfo m!"{name} uses {ax}"

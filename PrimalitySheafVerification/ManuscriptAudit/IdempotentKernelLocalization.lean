import Lean.Util.CollectAxioms
import Mathlib.RingTheory.Flat.Localization
import Mathlib.RingTheory.Ideal.Span

/-! A surjective ring map with a directed kernel generated by idempotents
is an actual localization, so in particular is flat. -/

namespace ManuscriptAudit.IdempotentKernelLocalization

noncomputable section

variable (R S : Type*) [CommRing R] [CommRing S] [Algebra R S]

/-- The multiplicative set of elements mapping to one. -/
def denominators : Submonoid R where
  carrier := {x | algebraMap R S x = 1}
  one_mem' := map_one _
  mul_mem' {x y} hx hy := by
    change algebraMap R S x = 1 at hx
    change algebraMap R S y = 1 at hy
    change algebraMap R S (x * y) = 1
    rw [map_mul, hx, hy, mul_one]

/-- An elementwise identity in the kernel annihilates each difference
whose two terms map to the same element. -/
theorem isLocalization_of_local_identities
    (onto : Function.Surjective (algebraMap R S))
    (h : ∀ x : R, algebraMap R S x = 0 → ∃ e : R, algebraMap R S e = 0 ∧ e * x = x) :
    IsLocalization (denominators R S) S := by
  apply (isLocalization_iff (denominators R S) S).mpr
  refine ⟨?_, ?_, ?_⟩
  · intro u
    have hu : algebraMap R S u = 1 := u.property
    rw [hu]
    exact isUnit_one
  · intro s
    obtain ⟨x, hx⟩ := onto s
    refine ⟨(x, 1), ?_⟩
    change s * algebraMap R S 1 = algebraMap R S x
    rw [map_one, mul_one, hx]
  · intro x y he
    have hd : algebraMap R S (x - y) = 0 := by rw [map_sub, he, sub_self]
    obtain ⟨e, he₀, he₁⟩ := h (x - y) hd
    let u : denominators R S := ⟨1 - e, by
      change algebraMap R S (1 - e) = 1
      rw [map_sub, map_one, he₀, sub_zero]⟩
    refine ⟨u, sub_eq_zero.mp ?_⟩
    change (1 - e) * x - (1 - e) * y = 0
    rw [← mul_sub, sub_mul, one_mul, he₁, sub_self]

/-- Surjective maps with a directed union of principal idempotent
kernels are localizations at the displayed multiplicative subset. -/
theorem isLocalization_of_directed_idempotents {I : Type*} [Nonempty I] (e : I → R)
    (he : ∀ i, e i * e i = e i)
    (hdir : Directed (· ≤ ·) (fun i ↦ Ideal.span ({e i} : Set R)))
    (hker : RingHom.ker (algebraMap R S) = ⨆ i, Ideal.span ({e i} : Set R))
    (onto : Function.Surjective (algebraMap R S)) :
    IsLocalization (denominators R S) S := by
  apply isLocalization_of_local_identities R S onto
  intro x hx
  have hx' : x ∈ RingHom.ker (algebraMap R S) := hx
  rw [hker] at hx'
  obtain ⟨i, hi⟩ := (Submodule.mem_iSup_of_directed _ hdir).mp hx'
  have hEi : algebraMap R S (e i) = 0 := by
    change e i ∈ RingHom.ker (algebraMap R S)
    rw [hker]
    exact (le_iSup (fun j ↦ Ideal.span ({e j} : Set R)) i) (Ideal.mem_span_singleton_self (e i))
  obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.mp hi
  refine ⟨e i, hEi, ?_⟩
  rw [← mul_assoc, mul_comm (e i) a, mul_assoc, he i]

theorem flat_of_directed_idempotents {I : Type*} [Nonempty I] (e : I → R)
    (he : ∀ i, e i * e i = e i)
    (hdir : Directed (· ≤ ·) (fun i ↦ Ideal.span ({e i} : Set R)))
    (hker : RingHom.ker (algebraMap R S) = ⨆ i, Ideal.span ({e i} : Set R))
    (onto : Function.Surjective (algebraMap R S)) :
    Module.Flat R S := by
  letI := isLocalization_of_directed_idempotents R S e he hdir hker onto
  exact IsLocalization.flat S (denominators R S)

end
end ManuscriptAudit.IdempotentKernelLocalization

open Lean Elab Command in
run_cmd do
  let allowed : List Name := [``propext, ``Classical.choice, ``Quot.sound]
  for name in [``ManuscriptAudit.IdempotentKernelLocalization.isLocalization_of_local_identities,
      ``ManuscriptAudit.IdempotentKernelLocalization.isLocalization_of_directed_idempotents,
      ``ManuscriptAudit.IdempotentKernelLocalization.flat_of_directed_idempotents] do
    let dependencies ← collectAxioms name
    let unexpected := dependencies.filter fun axiomName => !allowed.contains axiomName
    unless unexpected.isEmpty do
      throwError m!"{name} depends on unexpected axioms {unexpected}"
    logInfo m!"{name} uses {dependencies}"

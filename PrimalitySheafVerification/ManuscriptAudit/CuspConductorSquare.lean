import Lean.Util.CollectAxioms
import Mathlib.Algebra.Category.Ring.Constructions
import PrimalitySheafVerification.ManuscriptAudit.CuspDelta
import PrimalitySheafVerification.ManuscriptAudit.CuspPunctured
import PrimalitySheafVerification.ManuscriptAudit.CuspScheme

/-!
# The conductor square of the cusp

The cusp, its normalization, the residue field at the cusp, and the
square-zero neighborhood in the normalization form a pullback in
the category of commutative rings.
-/

namespace ManuscriptAudit.CuspConductorSquare

open CategoryTheory CategoryTheory.Limits Polynomial
open CuspDelta CuspPunctured

noncomputable section

universe u

variable (K : Type u) [Field K]

private abbrev squareIdeal : Ideal (Polynomial K) :=
  Ideal.span {((X : Polynomial K) ^ 2)}

/-- The map from the normalization ring to the square-zero neighborhood. -/
def reduction : CommRingCat.of (Polynomial K) ⟶ CommRingCat.of (cuspSquareQuotient K) :=
  CommRingCat.ofHom (cuspSquareReduction K)

/-- The constants in the square-zero neighborhood. -/
def constants : CommRingCat.of K ⟶ CommRingCat.of (cuspSquareQuotient K) :=
  CommRingCat.ofHom ((cuspSquareReduction K).comp Polynomial.C)

/-- The residue map from the cusp ring to the field at its origin. -/
def origin : CommRingCat.of (CuspSubalgebra K) ⟶ CommRingCat.of K :=
  CommRingCat.ofHom (cuspOriginResidue K)

set_option backward.isDefEq.respectTransparency false in
/-- The conductor square is a pullback with the actual cusp and quotient maps. -/
theorem conductor_isPullback :
    IsPullback (CuspScheme.inclusion K) (origin K) (reduction K) (constants K) := by
  let c := CommRingCat.pullbackCone (reduction K) (constants K)
  have h : IsPullback c.fst c.snd (reduction K) (constants K) :=
    IsPullback.of_isLimit (CommRingCat.pullbackConeIsLimit (reduction K) (constants K))
  let e : CommRingCat.of (CuspSubalgebra K) ≅ c.pt :=
    (paper2_cusp_conductor_pullback_equiv K).toCommRingCatIso
  refine h.of_iso' e (Iso.refl _) (Iso.refl _) (Iso.refl _) ?_ ?_ ?_ ?_
  · rw [Iso.refl_hom, Category.comp_id]
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro x
    rfl
  · rw [Iso.refl_hom, Category.comp_id]
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro x
    rfl
  · simp
  · simp

/-- The polynomial reduction defining the conductor square is surjective. -/
theorem reduction_surjective : Function.Surjective (reduction K).hom :=
  Ideal.Quotient.mk_surjective

/-- Reduction from the square-zero neighborhood to the origin. -/
def squareToResidue : cuspSquareQuotient K →+* K :=
  Ideal.Quotient.lift (squareIdeal K) Polynomial.constantCoeff (by
    intro f hf
    rw [squareIdeal, Ideal.mem_span_singleton, Polynomial.X_pow_dvd_iff] at hf
    change f.coeff 0 = 0
    exact hf 0 (by decide))

@[simp]
theorem squareToResidue_reduction (f : Polynomial K) :
    squareToResidue K (cuspSquareReduction K f) = f.coeff 0 :=
  rfl

/-- The reduction to the residue field is split by the constants. -/
theorem constants_comp_squareToResidue :
    constants K ≫ CommRingCat.ofHom (squareToResidue K) = 𝟙 (CommRingCat.of K) := by
  apply CommRingCat.hom_ext
  apply RingHom.ext
  intro a
  change squareToResidue K (cuspSquareReduction K (C a)) = a
  simp

/-- The kernel of reduction to the residue field is generated by the parameter. -/
theorem squareToResidue_ker :
    RingHom.ker (squareToResidue K) =
      Ideal.span {cuspSquareReduction K (X : Polynomial K)} := by
  apply Ideal.ext
  intro x
  obtain ⟨f, rfl⟩ := reduction_surjective K x
  change cuspSquareReduction K f ∈ RingHom.ker (squareToResidue K) ↔
    cuspSquareReduction K f ∈ Ideal.span {cuspSquareReduction K (X : Polynomial K)}
  rw [RingHom.mem_ker, Ideal.mem_span_singleton]
  constructor
  · intro hf
    have hX : (X : Polynomial K) ∣ f :=
      Polynomial.X_dvd_iff.mpr ((squareToResidue_reduction K f).symm.trans hf)
    exact _root_.map_dvd (cuspSquareReduction K) hX
  · rintro ⟨g, hg⟩
    rw [hg, map_mul, squareToResidue_reduction, Polynomial.coeff_X_zero, zero_mul]

/-- The kernel of reduction to the residue field has square zero. -/
theorem squareToResidue_ker_sq :
    RingHom.ker (squareToResidue K) ^ 2 = ⊥ := by
  rw [squareToResidue_ker, Ideal.span_singleton_pow, Ideal.span_singleton_eq_bot, ← map_pow]
  change Ideal.Quotient.mk (squareIdeal K) ((X : Polynomial K) ^ 2) = 0
  exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton _))

end

end ManuscriptAudit.CuspConductorSquare

open Lean Elab Command in
run_cmd do
  let allowed : List Name := [``propext, ``Classical.choice, ``Quot.sound]
  for name in [``ManuscriptAudit.CuspConductorSquare.conductor_isPullback,
      ``ManuscriptAudit.CuspConductorSquare.reduction_surjective,
      ``ManuscriptAudit.CuspConductorSquare.constants_comp_squareToResidue,
      ``ManuscriptAudit.CuspConductorSquare.squareToResidue_ker_sq] do
    let dependencies ← collectAxioms name
    let unexpected := dependencies.filter fun axiomName => !allowed.contains axiomName
    unless unexpected.isEmpty do
      throwError m!"{name} depends on unexpected axioms {unexpected}"
    logInfo m!"{name} uses {dependencies}"

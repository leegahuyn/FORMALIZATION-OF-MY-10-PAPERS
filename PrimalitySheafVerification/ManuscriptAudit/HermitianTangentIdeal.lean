import Lean.Util.CollectAxioms
import Mathlib.RingTheory.Ideal.Quotient.Operations
import PrimalitySheafVerification.ManuscriptAudit.HermitianTangentPolynomial
import PrimalitySheafVerification.ManuscriptAudit.HermitianTangentIdealMembership

/-! The Hermitian tangent ideal factors in the actual coordinate algebra. -/

namespace ManuscriptAudit.HermitianTangentIdeal

open HermitianTangentIdealMembership HermitianTangentPolynomial

noncomputable section

variable {R S : Type*} [CommRing R] [CommRing S]

private theorem map_pointIdeal_le_singleton (f : R →+* S) (U V u v : R) (c : S)
    (h : f (V - v) = c * f (U - u)) :
    (pointIdeal U V u v).map f ≤ Ideal.span {f (U - u)} := by
  rw [pointIdeal, Ideal.map_span]
  apply Ideal.span_le.mpr
  rintro _ ⟨x, hx, rfl⟩
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
  rcases hx with rfl | rfl
  · exact Ideal.mem_span_singleton_self _
  · rw [h]
    exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)

private theorem ideal_pow_mono {I J : Ideal S} (h : I ≤ J) (n : ℕ) :
    I ^ n ≤ J ^ n := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [pow_succ, pow_succ]
    exact Ideal.mul_mono ih h

variable (E : Type*) [Field E] [Fintype E] [Algebra E R]

local notation "q" => Fintype.card E

/-- The product of the point ideals is the principal ideal generated by the Hermitian tangent. -/
theorem tangent_ideal_eq {U V u v : R}
    (h : U ^ (q + 1) + V ^ (q + 1) = 1) (hP : u ^ (q + 1) + v ^ (q + 1) = 1)
    (hv : IsUnit v)
    (hCase : (u ^ (q * q) = u ∧ v ^ (q * q) = v) ∨
      pointIdeal U V u v ⊔ pointIdeal U V (u ^ (q * q)) (v ^ (q * q)) = ⊤) :
    Ideal.span {tangent q U V u v} =
      pointIdeal U V u v ^ q * pointIdeal U V (u ^ (q * q)) (v ^ (q * q)) := by
  let g := tangent q U V u v
  let I : Ideal R := Ideal.span {g}
  let f := Ideal.Quotient.mk I
  let J := pointIdeal U V u v
  let J' := pointIdeal U V (u ^ (q * q)) (v ^ (q * q))
  change I = J ^ q * J'
  apply le_antisymm
  · exact Ideal.span_singleton_le_iff_mem.mpr (tangent_mem_product E h hP hCase)
  have hF : f g = 0 :=
    (Ideal.Quotient.eq_zero_iff_mem).mpr (Ideal.mem_span_singleton_self g)
  have hHermitian : (f U) ^ (q + 1) + (f V) ^ (q + 1) = 1 := by
    simpa only [map_add, map_pow, map_one] using congrArg f h
  have hPoint : (f u) ^ (q + 1) + (f v) ^ (q + 1) = 1 := by
    simpa only [map_add, map_pow, map_one] using congrArg f hP
  have hLine : (f u) ^ q * f U + (f v) ^ q * f V = 1 := by
    change f (u ^ q * (U - u) + v ^ q * (V - v)) = 0 at hF
    simp only [map_add, map_mul, map_pow, map_sub] at hF
    have hp := hPoint
    rw [pow_succ (f u) q, pow_succ (f v) q] at hp
    linear_combination hF + hp
  have hFrobPoint : (f u) ^ q * f (u ^ (q * q)) + (f v) ^ q * f (v ^ (q * q)) = 1 := by
    simp only [map_pow]
    exact frobenius_pairing E hPoint
  obtain ⟨c, hc⟩ := ((hv.map f).pow q)
  let a : R ⧸ I := -(↑(c⁻¹) * (f u) ^ q)
  have hCoordinates (x y : R) (hXY : (f u) ^ q * f x + (f v) ^ q * f y = 1) :
      f (V - y) = a * f (U - x) := by
    have he : (f v) ^ q * f (V - y) = -((f u) ^ q * f (U - x)) := by
      rw [map_sub, map_sub]
      linear_combination hLine - hXY
    calc
      _ = (↑(c⁻¹) : R ⧸ I) * ((f v) ^ q * f (V - y)) := by
        rw [← hc, ← mul_assoc]
        simp
      _ = _ := by rw [he]; dsimp only [a]; ring
  have hJ : J.map f ≤ Ideal.span {f (U - u)} := by
    apply map_pointIdeal_le_singleton f U V u v a
    apply hCoordinates
    simpa only [pow_succ] using hPoint
  have hJ' : J'.map f ≤ Ideal.span {f (U - u ^ (q * q))} :=
    map_pointIdeal_le_singleton f U V _ _ a (hCoordinates _ _ hFrobPoint)
  have hSub : 1 - (f u) ^ q * f U = (f v) ^ q * f V := by
    linear_combination -hLine
  have hZeros : (f (U - u)) ^ q * f (U - u ^ (q * q)) = 0 := by
    rw [map_sub, map_sub, map_pow]
    have he := tangent_factorization E (R ⧸ I) (f u) (f v) (f U) hPoint
    dsimp only at he
    rw [← he, hSub, mul_pow, ← pow_mul]
    linear_combination ((f v) ^ (q * (q + 1))) * hHermitian
  have hMap : (J ^ q * J').map f ≤ (⊥ : Ideal (R ⧸ I)) := by
    rw [Ideal.map_mul, Ideal.map_pow]
    apply (Ideal.mul_mono (ideal_pow_mono hJ q) hJ').trans
    rw [Ideal.span_singleton_pow, Ideal.span_singleton_mul_span_singleton, hZeros]
    simp
  intro z hz
  apply (Ideal.Quotient.eq_zero_iff_mem).mp
  have hmem := hMap (Ideal.mem_map_of_mem f hz)
  simpa using hmem

end
end ManuscriptAudit.HermitianTangentIdeal

open Lean Elab Command in
run_cmd do
  let name := ``ManuscriptAudit.HermitianTangentIdeal.tangent_ideal_eq
  let allowed : List Name := [``propext, ``Classical.choice, ``Quot.sound]
  let ax ← collectAxioms name
  let bad := ax.filter fun x => !allowed.contains x
  unless bad.isEmpty do
    throwError m!"{name} depends on unexpected axioms {bad}"
  logInfo m!"{name} uses {ax}"

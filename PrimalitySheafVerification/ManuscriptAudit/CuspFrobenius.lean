import Lean.Util.CollectAxioms
import Mathlib.Algebra.CharP.Frobenius
import Mathlib.Algebra.CharP.Subring
import Mathlib.Tactic.Ring
import PrimalitySheafVerification.ManuscriptAudit.CuspDelta
import PrimalitySheafVerification.ManuscriptAudit.CuspPunctured

/-!
# Frobenius factors through the cusp coordinate ring

For positive prime characteristic the Frobenius on the polynomial
normalization has image in the subalgebra generated by t² and t³.
Both composites with the inclusion are the actual absolute Frobenius maps.
-/

namespace ManuscriptAudit.CuspFrobenius

open Polynomial CuspDelta CuspPunctured

noncomputable section

variable (K : Type*) [Field K]

private theorem coeff_one_succ_pow (f : Polynomial K) (n : ℕ) :
    (f ^ (n + 1)).coeff 1 = ((n + 1 : ℕ) : K) * f.coeff 0 ^ n * f.coeff 1 := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [show f ^ (n + 1 + 1) = f ^ (n + 1) * f from pow_succ f (n + 1),
      Polynomial.mul_coeff_one, ih]
    have h : (f ^ (n + 1)).coeff 0 = f.coeff 0 ^ (n + 1) :=
      map_pow (Polynomial.constantCoeff : Polynomial K →+* K) f (n + 1)
    rw [h, pow_succ, Nat.cast_succ]
    ring

variable (p : ℕ) [Fact p.Prime] [CharP K p]

local instance polyCharP : CharP (Polynomial K) p :=
  charP_of_injective_algebraMap (algebraMap K (Polynomial K)).injective p

local instance cuspCharP : CharP (CuspSubalgebra K) p :=
  charP_of_injective_algebraMap (algebraMap K (CuspSubalgebra K)).injective p

/-- Every pth power of the polynomial normalization lies in the cusp ring. -/
theorem frobenius_mem_cusp (f : Polynomial K) : f ^ p ∈ CuspSubalgebra K := by
  apply (cusp_mem_iff_coeff_one_zero K _).mpr
  have hp : 1 ≤ p := (show Nat.Prime p from Fact.out).pos
  have h := coeff_one_succ_pow K f (p - 1)
  rw [Nat.sub_add_cancel hp, CharP.cast_eq_zero K p, zero_mul, zero_mul] at h
  exact h

/-- The factorization of absolute Frobenius through the cusp ring. -/
def normalizationFrobeniusToCusp : Polynomial K →+* CuspSubalgebra K :=
  (frobenius (Polynomial K) p).codRestrict (CuspSubalgebra K).toSubring
    (fun f => frobenius_mem_cusp K p f)

theorem inclusion_comp_normalizationFrobenius :
    (algebraMap (CuspSubalgebra K) (Polynomial K)).comp (normalizationFrobeniusToCusp K p) =
      frobenius (Polynomial K) p := by
  ext f
  rfl

theorem normalizationFrobenius_comp_inclusion :
    (normalizationFrobeniusToCusp K p).comp (algebraMap (CuspSubalgebra K) (Polynomial K)) =
      frobenius (CuspSubalgebra K) p := by
  apply RingHom.ext
  intro f
  apply Subtype.ext
  exact (map_pow (algebraMap (CuspSubalgebra K) (Polynomial K)) f p).symm

end

end ManuscriptAudit.CuspFrobenius

open Lean Elab Command in
run_cmd do
  let allowed : List Name := [``propext, ``Classical.choice, ``Quot.sound]
  for name in [``ManuscriptAudit.CuspFrobenius.frobenius_mem_cusp,
      ``ManuscriptAudit.CuspFrobenius.inclusion_comp_normalizationFrobenius,
      ``ManuscriptAudit.CuspFrobenius.normalizationFrobenius_comp_inclusion] do
    let dependencies ← collectAxioms name
    let unexpected := dependencies.filter fun axiomName => !allowed.contains axiomName
    unless unexpected.isEmpty do
      throwError m!"{name} depends on unexpected axioms {unexpected}"
    logInfo m!"{name} uses {dependencies}"

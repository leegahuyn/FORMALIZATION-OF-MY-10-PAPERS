import Lean.Util.CollectAxioms
import PrimalitySheafVerification.ManuscriptAudit.WeierstrassInfinityOpenCover
import PrimalitySheafVerification.ManuscriptAudit.WeierstrassInfinityDedekind
import PrimalitySheafVerification.ManuscriptAudit.WeierstrassAffineUnitRestriction
import PrimalitySheafVerification.ManuscriptAudit.MayerVietorisZeroRange
import PrimalitySheafVerification.ManuscriptAudit.PrimeLocalizationUnits

/-! The exact subgroup of native projective unit H¹ killed by both open
restrictions is the integer group generated by the Cartier edge at infinity. -/

namespace ManuscriptAudit.WeierstrassCartierBoundaryCohomology

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits CategoryTheory.Abelian Opposite
open WeierstrassProjectiveClosure WeierstrassCartierInfinity
open WeierstrassInfinityChartAlgebra WeierstrassInfinityOpenCover WeierstrassInfinityPuncture
open EtaleOpenIntersection EtaleAffineUnitNaturality KummerUnitsSheaf

noncomputable section

set_option backward.defeqAttrib.useBackward true
set_option backward.isDefEq.respectTransparency false

attribute [local instance] GeometricSkyscraperCohomology.etaleSiteHasExt

variable {K : Type} [Field K] [IsAlgClosed K] (W : WeierstrassCurve.Affine K) [W.IsElliptic]

local instance : IsOpenImmersion (neighborhoodOpen W) := neighborhoodOpen_isOpenImmersion W

private instance neighborhoodDomain : IsDomain (Neighborhood W) :=
  (WeierstrassInfinityDedekind.neighborhood_isDedekindDomain W).toIsDomain

private abbrev square := EtaleMayerVietoris.openCoverSquare (neighborhoodOpen W) (affineOpen W)
  (pullback.fst (neighborhoodOpen W) (affineOpen W) ≫ neighborhoodOpen W)
  (fstLeg (neighborhoodOpen W) (affineOpen W)) (sndLeg (neighborhoodOpen W) (affineOpen W))
  (intersection_isPullback (neighborhoodOpen W) (affineOpen W)) (cover W)

private abbrev F := fullCoordinateUnitSheaf (projectiveScheme W)
private abbrev s := localX W
private abbrev pUnit := PrimeLocalizationUnits.primeUnit (s W)
private abbrev liftUnit := PrimeLocalizationUnits.mapUnit (s W)

private def openUnits :
    (F W).H' 0 (square W).X₂ ≃+ Additive (Neighborhood W)ˣ :=
  coordinateUnitEquiv (Iso.refl (neighborhoodScheme W))

private def overlapUnits :
    (F W).H' 0 (square W).X₁ ≃+ Additive (Puncture W)ˣ :=
  coordinateUnitEquiv (overlapIso W)

private abbrev firstRestriction :=
  ((F W).cohomologyPresheaf 0).map (square W).f₁₂.op

private theorem firstRestriction_units (v : (F W).H' 0 (square W).X₂) :
    overlapUnits W (firstRestriction W v) =
      Additive.ofMul (liftUnit W (openUnits W v).toMul) := by
  refine coordinateUnitEquiv_naturality (square W).f₁₂ (overlapIso W)
    (Iso.refl (neighborhoodScheme W))
    (CommRingCat.ofHom (algebraMap (Neighborhood W) (Puncture W))) ?_ v
  change (overlapIso W).inv ≫ pullback.fst (neighborhoodOpen W) (affineOpen W) =
    punctureToNeighborhood W ≫ 𝟙 (neighborhoodScheme W)
  rw [Category.comp_id, ← overlapIso_fac, Iso.inv_hom_id_assoc]

private def delta : (F W).H' 0 (square W).X₁ →+ (F W).H' 1 (square W).X₄ :=
  ((square W).δ (F W) 0 1 rfl).hom

private theorem delta_ker :
    (delta W).ker = (firstRestriction W).hom.range := by
  have hl : Function.Surjective (((F W).cohomologyPresheaf 0).map (square W).f₃₄.op) :=
    WeierstrassAffineUnitRestriction.global_to_affine_surjective W
  have hr := MayerVietorisZeroRange.range_fromBiprod_eq_left (square W) (F W) hl
  have hE : (((square W).fromBiprod (F W) 0).hom).range = (delta W).ker :=
    (((square W).sequence_exact (F W) 0 1 rfl).exact' 1 2 3).ab_range_eq_ker
  exact hE.symm.trans hr

private theorem delta_liftUnit_zero (u : (Neighborhood W)ˣ) :
    delta W ((overlapUnits W).symm (Additive.ofMul (liftUnit W u))) = 0 := by
  change (overlapUnits W).symm (Additive.ofMul (liftUnit W u)) ∈ (delta W).ker
  rw [delta_ker]
  let v := (openUnits W).symm (Additive.ofMul u)
  refine ⟨v, (overlapUnits W).injective ?_⟩
  change overlapUnits W (firstRestriction W v) = _
  rw [firstRestriction_units, (overlapUnits W).apply_symm_apply]
  have hv : (openUnits W v).toMul = u :=
    congrArg Additive.toMul ((openUnits W).apply_symm_apply (Additive.ofMul u))
  rw [hv]

private def primePowers : ℤ →+ Additive (Puncture W)ˣ where
  toFun n := Additive.ofMul (pUnit W ^ n)
  map_zero' := by
    change Additive.ofMul (pUnit W ^ (0 : ℤ)) = Additive.ofMul 1
    rw [zpow_zero]
  map_add' a b := by
    change Additive.ofMul (pUnit W ^ (a + b)) = Additive.ofMul (pUnit W ^ a * pUnit W ^ b)
    rw [zpow_add]

/-- The integer class of the actual Cartier coordinate transition,
as a map into genuine projective unit cohomology. -/
def boundaryClass : ℤ →+ (F W).H' 1 (square W).X₄ :=
  (delta W).comp ((overlapUnits W).symm.toAddMonoidHom.comp (primePowers W))

theorem boundaryClass_injective : Function.Injective (boundaryClass W) := by
  apply (injective_iff_map_eq_zero _).mpr
  intro n hn
  have h : (overlapUnits W).symm (Additive.ofMul (pUnit W ^ n)) ∈ (delta W).ker := hn
  rw [delta_ker] at h
  obtain ⟨v, hv⟩ := h
  change firstRestriction W v = (overlapUnits W).symm (Additive.ofMul (pUnit W ^ n)) at hv
  have he := firstRestriction_units W v
  rw [hv, (overlapUnits W).apply_symm_apply] at he
  have hp : liftUnit W 1 * pUnit W ^ n =
      liftUnit W (openUnits W v).toMul * pUnit W ^ (0 : ℤ) := by
    simpa only [map_one, one_mul, zpow_zero, mul_one] using congrArg Additive.toMul he
  exact PrimeLocalizationUnits.exponent_unique (s W) (localX_prime W) _ _ n 0 hp

private theorem boundary_range : (boundaryClass W).range = (delta W).range := by
  ext a
  constructor
  · rintro ⟨n, rfl⟩
    exact ⟨_, rfl⟩
  · rintro ⟨v, rfl⟩
    obtain ⟨u, n, hv⟩ := PrimeLocalizationUnits.exists_lift_mul_zpow (s W)
      (localX_prime W) (overlapUnits W v).toMul
    have hDecomp : v = (overlapUnits W).symm (Additive.ofMul (liftUnit W u)) +
        (overlapUnits W).symm (Additive.ofMul (pUnit W ^ n)) := by
      apply (overlapUnits W).injective
      rw [map_add, (overlapUnits W).apply_symm_apply, (overlapUnits W).apply_symm_apply]
      exact congrArg Additive.ofMul hv
    refine ⟨n, ?_⟩
    change delta W ((overlapUnits W).symm (Additive.ofMul (pUnit W ^ n))) = delta W v
    rw [hDecomp, map_add, delta_liftUnit_zero, zero_add]

/-- The Cartier copy of Z is exactly the kernel of both actual chart
restrictions on the native first cohomology of the unit sheaf. -/
theorem boundaryClass_exact :
    (boundaryClass W).range = (((square W).toBiprod (F W) 1).hom).ker := by
  rw [boundary_range]
  exact (((square W).sequence_exact (F W) 0 1 rfl).exact' 2 3 4).ab_range_eq_ker

end

end ManuscriptAudit.WeierstrassCartierBoundaryCohomology

open Lean Elab Command in
run_cmd do
  let allowed : List Name := [``propext, ``Classical.choice, ``Quot.sound]
  for name in [``ManuscriptAudit.WeierstrassCartierBoundaryCohomology.boundaryClass_injective,
      ``ManuscriptAudit.WeierstrassCartierBoundaryCohomology.boundaryClass_exact] do
    let ax ← collectAxioms name
    let bad := ax.filter fun n => !allowed.contains n
    unless bad.isEmpty do
      throwError m!"{name} depends on unexpected axioms {bad}"
    logInfo m!"{name} uses {ax}"

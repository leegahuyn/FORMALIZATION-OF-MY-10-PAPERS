/-!
# The coordinate quotient of the cusp inclusion

Paper 2, p. 40, Proposition 3.24 uses a local δ contribution. This file
calculates the vector-space quotient of the coordinate inclusion
K[X²,X³] ⊂ K[X]. The coefficient of X identifies the quotient with K.
-/

namespace ManuscriptAudit.CuspDelta

open Polynomial

noncomputable section

variable (K : Type*) [Field K]

private abbrev cuspSubalgebra : Subalgebra K (Polynomial K) :=
  Algebra.adjoin K ({(X : Polynomial K) ^ 2, X ^ 3} : Set (Polynomial K))

private theorem pow_mem_cusp (n : ℕ) (hn : n ≠ 1) :
    (X : Polynomial K) ^ n ∈ cuspSubalgebra K := by
  have h2 : (X : Polynomial K) ^ 2 ∈ cuspSubalgebra K :=
    Algebra.subset_adjoin (by simp)
  have h3 : (X : Polynomial K) ^ 3 ∈ cuspSubalgebra K :=
    Algebra.subset_adjoin (by simp)
  by_cases heven : n % 2 = 0
  · have hform : n = 2 * (n / 2) := by omega
    rw [hform, pow_mul]
    exact (cuspSubalgebra K).pow_mem h2 _
  · have hform : n = 3 + 2 * ((n - 3) / 2) := by omega
    rw [hform, pow_add, pow_mul]
    exact (cuspSubalgebra K).mul_mem h3 ((cuspSubalgebra K).pow_mem h2 _)

private theorem cusp_mem_iff_coeff_one_zero (f : Polynomial K) :
    f ∈ cuspSubalgebra K ↔ f.coeff 1 = 0 := by
  constructor
  · intro hf
    refine Algebra.adjoin_induction (p := fun g _ => g.coeff 1 = 0) ?_ ?_ ?_ ?_ hf
    · intro g hg
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hg
      rcases hg with h | h <;> subst g <;> simp
    · intro a
      simp
    · intro g h _ _ hg hh
      simp [hg, hh]
    · intro g h _ _ hg hh
      simp [Polynomial.mul_coeff_one, hg, hh]
  · intro hf
    rw [← Polynomial.sum_C_mul_X_pow_eq f, Polynomial.sum]
    apply (cuspSubalgebra K).sum_mem
    intro n hn
    have hne : n ≠ 1 := by
      intro h
      subst n
      exact (Polynomial.mem_support_iff.mp hn) hf
    rw [Polynomial.C_eq_algebraMap]
    exact (cuspSubalgebra K).mul_mem ((cuspSubalgebra K).algebraMap_mem _)
      (pow_mem_cusp K n hne)

private theorem cusp_submodule_eq_ker :
    (cuspSubalgebra K).toSubmodule = (Polynomial.lcoeff K 1).ker := by
  ext f
  simpa only [Subalgebra.mem_toSubmodule, LinearMap.mem_ker, Polynomial.lcoeff_apply]
    using cusp_mem_iff_coeff_one_zero K f

private def cusp_quotient_equiv :
    (Polynomial K ⧸ (cuspSubalgebra K).toSubmodule) ≃ₗ[K] K := by
  rw [cusp_submodule_eq_ker]
  refine (Polynomial.lcoeff K 1).quotKerEquivOfSurjective ?_
  intro a
  exact ⟨Polynomial.monomial 1 a, by simp⟩

/-- The coordinate quotient of K[X²,X³] inside K[X] has dimension one. -/
theorem paper2_cusp_delta_coordinate_quotient_finrank :
    Module.finrank K
      (Polynomial K ⧸ (Algebra.adjoin K
        ({(X : Polynomial K) ^ 2, X ^ 3} : Set (Polynomial K))).toSubmodule) = 1 :=
  (LinearEquiv.finrank_eq (cusp_quotient_equiv K)).trans (Module.finrank_self K)

/-- Over the cusp coordinate ring, the polynomial ring is generated by 1 and X. -/
private theorem cusp_span_one_X :
    Submodule.span (cuspSubalgebra K) ({1, X} : Set (Polynomial K)) = ⊤ := by
  apply top_unique
  intro f _
  let S := Submodule.span (cuspSubalgebra K) ({1, X} : Set (Polynomial K))
  let a : cuspSubalgebra K := ⟨f - C (f.coeff 1) * X, by
    apply (cusp_mem_iff_coeff_one_zero K _).2
    simp⟩
  let b : cuspSubalgebra K := ⟨C (f.coeff 1), by
    rw [Polynomial.C_eq_algebraMap]
    exact (cuspSubalgebra K).algebraMap_mem _⟩
  have h₁ : (1 : Polynomial K) ∈ S := Submodule.subset_span (by simp)
  have hX : (X : Polynomial K) ∈ S := Submodule.subset_span (by simp)
  have hf : a • (1 : Polynomial K) + b • (X : Polynomial K) = f := by
    change (f - C (f.coeff 1) * X) * 1 + C (f.coeff 1) * X = f
    rw [mul_one, sub_add_cancel]
  rw [← hf]
  exact S.add_mem (S.smul_mem a h₁) (S.smul_mem b hX)

/-- The inclusion of the cusp coordinate ring into K[X] is module-finite. -/
theorem paper2_cusp_inclusion_finite :
    Module.Finite
      (Algebra.adjoin K ({(X : Polynomial K) ^ 2, X ^ 3} : Set (Polynomial K)))
      (Polynomial K) := by
  classical
  refine ⟨⟨{1, X}, ?_⟩⟩
  simpa only [Finset.coe_insert, Finset.coe_singleton] using cusp_span_one_X K

/-- The cusp coordinate inclusion is integral. -/
theorem paper2_cusp_inclusion_integral :
    Algebra.IsIntegral
      (Algebra.adjoin K ({(X : Polynomial K) ^ 2, X ^ 3} : Set (Polynomial K)))
      (Polynomial K) := by
  letI := paper2_cusp_inclusion_finite K
  exact Algebra.IsIntegral.of_finite _ _


private theorem mul_X_sq_mem_cusp (f : Polynomial K) :
    f * (X : Polynomial K) ^ 2 ∈ cuspSubalgebra K := by
  apply (cusp_mem_iff_coeff_one_zero K _).2
  simp only [Polynomial.coeff_mul_X_pow', if_neg (by decide : ¬ (2 : ℕ) ≤ 1)]

/-- The cusp subalgebra has the same fraction field as K[X].
A fraction f/g can be written as (fX²)/(gX²), with both polynomials
in the subalgebra. -/
theorem paper2_cusp_fraction_field :
    IsFractionRing
      (Algebra.adjoin K ({(X : Polynomial K) ^ 2, X ^ 3} : Set (Polynomial K)))
      (FractionRing (Polynomial K)) := by
  refine IsFractionRing.of_field (cuspSubalgebra K) (FractionRing (Polynomial K)) ?_
  intro q
  obtain ⟨f, g, _, hq⟩ := IsFractionRing.div_surjective (Polynomial K) q
  let a : cuspSubalgebra K := ⟨f * X ^ 2, mul_X_sq_mem_cusp K f⟩
  let b : cuspSubalgebra K := ⟨g * X ^ 2, mul_X_sq_mem_cusp K g⟩
  have hX : algebraMap (Polynomial K) (FractionRing (Polynomial K))
      ((X : Polynomial K) ^ 2) ≠ 0 :=
    (map_ne_zero_iff _ (IsFractionRing.injective (Polynomial K) (FractionRing (Polynomial K)))).mpr
      (pow_ne_zero 2 Polynomial.X_ne_zero)
  refine ⟨a, b, ?_⟩
  change q = algebraMap (Polynomial K) (FractionRing (Polynomial K)) (f * X ^ 2) /
    algebraMap (Polynomial K) (FractionRing (Polynomial K)) (g * X ^ 2)
  simpa only [map_mul, mul_div_mul_right _ _ hX] using hq.symm

/-- The polynomial algebra is the integral closure of the cusp
subalgebra in their common fraction field. -/
theorem paper2_cusp_polynomial_is_integral_closure :
    IsIntegralClosure (Polynomial K)
      (Algebra.adjoin K ({(X : Polynomial K) ^ 2, X ^ 3} : Set (Polynomial K)))
      (FractionRing (Polynomial K)) := by
  classical
  letI : GCDMonoid (Polynomial K) := EuclideanDomain.gcdMonoid _
  letI : Algebra.IsIntegral (cuspSubalgebra K) (Polynomial K) :=
    paper2_cusp_inclusion_integral K
  exact IsIntegralClosure.of_isIntegrallyClosed (Polynomial K) (cuspSubalgebra K)
    (FractionRing (Polynomial K))

/-- The two monomials generating the cusp coordinate algebra. -/
private abbrev cuspX2 : cuspSubalgebra K :=
  ⟨(Polynomial.X : Polynomial K) ^ 2, Algebra.subset_adjoin (by simp)⟩

private abbrev cuspX3 : cuspSubalgebra K :=
  ⟨(Polynomial.X : Polynomial K) ^ 3, Algebra.subset_adjoin (by simp)⟩

private theorem cusp_generator_relation : cuspX2 K ^ 3 = cuspX3 K ^ 2 := by
  apply Subtype.ext
  change ((Polynomial.X : Polynomial K) ^ 2) ^ 3 = (Polynomial.X ^ 3) ^ 2
  calc
    _ = (Polynomial.X : Polynomial K) ^ (2 * 3) := (pow_mul _ 2 3).symm
    _ = (Polynomial.X : Polynomial K) ^ (3 * 2) := rfl
    _ = _ := pow_mul _ 3 2

variable (L : Type*) [Field L] [Algebra K L]

/-- Restriction along \(K[X^2,X^3]\subseteq K[X]\). -/
def cuspRestriction (f : Polynomial K →ₐ[K] L) : cuspSubalgebra K →ₐ[K] L :=
  f.comp (cuspSubalgebra K).val

private theorem cusp_param_exists {x y : L} (hxy : x ^ 3 = y ^ 2) :
    ∃ t : L, t ^ 2 = x ∧ t ^ 3 = y := by
  by_cases hx : x = 0
  · have hy : y = 0 := sq_eq_zero_iff.mp (hxy.symm.trans (by simp [hx]))
    exact ⟨0, by simp [hx], by simp [hy]⟩
  · have hsq : (y / x) ^ 2 = x := by
      rw [div_pow, ← hxy]
      apply (div_eq_iff (pow_ne_zero 2 hx)).mpr
      exact (pow_succ x 2).trans (mul_comm _ _)
    refine ⟨y / x, hsq, ?_⟩
    calc
      (y / x) ^ 3 = (y / x) ^ 2 * (y / x) := pow_succ _ 2
      _ = x * (y / x) := by rw [hsq]
      _ = (y / x) * x := mul_comm _ _
      _ = y := div_mul_cancel₀ y hx

private theorem cusp_param_unique {a b : L} (hs : a ^ 2 = b ^ 2)
    (hc : a ^ 3 = b ^ 3) : a = b := by
  by_cases ha : a = 0
  · have hb : b = 0 := sq_eq_zero_iff.mp (hs.symm.trans (by simp [ha]))
    exact ha.trans hb.symm
  · apply mul_left_cancel₀ (pow_ne_zero 2 ha)
    calc
      a ^ 2 * a = a ^ 3 := (pow_succ a 2).symm
      _ = b ^ 3 := hc
      _ = b ^ 2 * b := pow_succ b 2
      _ = a ^ 2 * b := by rw [hs]

/-- Every field-valued point of the cusp has a unique lift along the
coordinate inclusion into the polynomial algebra. The target is any
field with a \(K\)-algebra structure. This proves the field-valued
point statement used in the normalization comparison. -/
theorem paper2_cusp_field_points_bijective :
    Function.Bijective (cuspRestriction K L) := by
  constructor
  · intro f g h
    apply Polynomial.algHom_ext
    have hs := AlgHom.congr_fun h (cuspX2 K)
    have hc := AlgHom.congr_fun h (cuspX3 K)
    change f ((Polynomial.X : Polynomial K) ^ 2) =
      g ((Polynomial.X : Polynomial K) ^ 2) at hs
    change f ((Polynomial.X : Polynomial K) ^ 3) =
      g ((Polynomial.X : Polynomial K) ^ 3) at hc
    exact cusp_param_unique L (by simpa only [map_pow] using hs)
      (by simpa only [map_pow] using hc)
  · intro h
    have hxy : h (cuspX2 K) ^ 3 = h (cuspX3 K) ^ 2 := by
      simpa only [map_pow] using congrArg h (cusp_generator_relation K)
    obtain ⟨t, h2, h3⟩ := cusp_param_exists L hxy
    refine ⟨Polynomial.aeval t, ?_⟩
    apply AlgHom.adjoin_ext (s := ({(Polynomial.X : Polynomial K) ^ 2,
      Polynomial.X ^ 3} : Set (Polynomial K)))
    intro p hp
    rcases Set.mem_insert_iff.mp hp with hp2 | hp3
    · subst p
      change Polynomial.aeval t ((Polynomial.X : Polynomial K) ^ 2) = h (cuspX2 K)
      simpa only [Polynomial.aeval_X_pow] using h2
    · have he := Set.mem_singleton_iff.mp hp3
      subst p
      change Polynomial.aeval t ((Polynomial.X : Polynomial K) ^ 3) = h (cuspX3 K)
      simpa only [Polynomial.aeval_X_pow] using h3

/-- The equation \(Y^2-X^3\) in \(K[X][Y]\). -/
def cuspPlaneEquation : Polynomial (Polynomial K) :=
  Polynomial.X ^ 2 - Polynomial.C ((Polynomial.X : Polynomial K) ^ 3)

private theorem cuspPlaneEquation_monic : (cuspPlaneEquation K).Monic :=
  Polynomial.monic_X_pow_sub_C ((Polynomial.X : Polynomial K) ^ 3) (n := 2) (by decide)

private theorem cuspPlaneEquation_natDegree : (cuspPlaneEquation K).natDegree = 2 :=
  Polynomial.natDegree_X_pow_sub_C

private theorem eq_linear_polynomial_of_natDegree_lt_two {R : Type*} [CommSemiring R]
    (r : Polynomial R) (hr : r.natDegree < 2) :
    r = Polynomial.C (r.coeff 0) + Polynomial.C (r.coeff 1) * Polynomial.X := by
  apply Polynomial.ext
  intro n
  cases n with
  | zero => simp
  | succ n =>
    cases n with
    | zero => simp [Polynomial.coeff_C_mul_X]
    | succ n =>
      have hdeg : r.natDegree < n.succ.succ := by omega
      rw [Polynomial.coeff_eq_zero_of_natDegree_lt hdeg]
      simp [Polynomial.coeff_C_mul_X]

/-- In the parametrization \(X=t^2,\ Y=t^3\), the two terms of a
linear remainder in \(Y\) have distinct coefficient parities. -/
theorem cusp_expanded_linear_eq_zero (a b : Polynomial K)
    (h : Polynomial.expand K 2 a + Polynomial.expand K 2 b * Polynomial.X ^ 3 = 0) :
    a = 0 ∧ b = 0 := by
  have hb : b = 0 := by
    apply Polynomial.ext
    intro n
    have hn : ¬(2 ∣ 2 * n + 3) := by
      rintro ⟨m, hm⟩
      omega
    have ha : (Polynomial.expand K 2 a).coeff (2 * n + 3) = 0 := by
      rw [Polynomial.coeff_expand (by decide : 0 < (2 : ℕ)), if_neg hn]
    have he := congrArg (fun f : Polynomial K => f.coeff (2 * n + 3)) h
    change (Polynomial.expand K 2 a +
      Polynomial.expand K 2 b * Polynomial.X ^ 3).coeff (2 * n + 3) =
      (0 : Polynomial K).coeff (2 * n + 3) at he
    rw [Polynomial.coeff_add, ha, zero_add, Polynomial.coeff_mul_X_pow,
      Polynomial.coeff_expand_mul' (by decide : 0 < (2 : ℕ)), Polynomial.coeff_zero] at he
    simpa only [Polynomial.coeff_zero] using he
  have ha : Polynomial.expand K 2 a = 0 := by simpa [hb] using h
  exact ⟨(Polynomial.expand_eq_zero (by decide : 0 < (2 : ℕ))).mp ha, hb⟩

private abbrev cuspBaseMap : Polynomial K →ₐ[K] cuspSubalgebra K :=
  Polynomial.aeval (cuspX2 K)

private theorem cuspBaseMap_val :
    (cuspSubalgebra K).val.comp (cuspBaseMap K) = Polynomial.expand K 2 := by
  apply Polynomial.algHom_ext
  change ((cuspBaseMap K (Polynomial.X : Polynomial K) : cuspSubalgebra K) :
    Polynomial K) = Polynomial.expand K 2 Polynomial.X
  simp only [cuspBaseMap, Polynomial.aeval_X, Polynomial.expand_X] <;> rfl

private theorem cuspPlaneEquation_eval :
    (cuspPlaneEquation K).eval₂ (cuspBaseMap K).toRingHom (cuspX3 K) = 0 := by
  simp only [cuspPlaneEquation, Polynomial.eval₂_sub, Polynomial.eval₂_pow,
    Polynomial.eval₂_X, Polynomial.eval₂_C, map_pow]
  change cuspX3 K ^ 2 - (Polynomial.aeval (cuspX2 K) (Polynomial.X : Polynomial K)) ^ 3 = 0
  rw [Polynomial.aeval_X, cusp_generator_relation, sub_self]

private def cuspParametrization : AdjoinRoot (cuspPlaneEquation K) →ₐ[K] cuspSubalgebra K :=
  AdjoinRoot.liftAlgHom (cuspPlaneEquation K) (cuspBaseMap K) (cuspX3 K)
    (cuspPlaneEquation_eval K)

private theorem cuspParametrization_coeff (f : Polynomial K) :
    cuspParametrization K (AdjoinRoot.of (cuspPlaneEquation K) f) = cuspBaseMap K f :=
  AdjoinRoot.liftAlgHom_of (cuspPlaneEquation K) (cuspBaseMap K) (cuspX3 K)
    (cuspPlaneEquation_eval K) f

private theorem cuspParametrization_root :
    cuspParametrization K (AdjoinRoot.root (cuspPlaneEquation K)) = cuspX3 K :=
  AdjoinRoot.liftAlgHom_root (cuspPlaneEquation K) (cuspBaseMap K) (cuspX3 K)
    (cuspPlaneEquation_eval K)

private theorem cuspParametrization_mk (f : Polynomial (Polynomial K)) :
    cuspParametrization K (AdjoinRoot.mk (cuspPlaneEquation K) f) =
      f.eval₂ (cuspBaseMap K).toRingHom (cuspX3 K) :=
  AdjoinRoot.liftAlgHom_mk (cuspPlaneEquation K) (cuspBaseMap K) (cuspX3 K)
    (cuspPlaneEquation_eval K) f

private theorem cuspParametrization_surjective :
    Function.Surjective (cuspParametrization K) := by
  let F := (cuspSubalgebra K).val.comp (cuspParametrization K)
  have h2 : (Polynomial.X : Polynomial K) ^ 2 ∈ F.range := by
    refine ⟨AdjoinRoot.of (cuspPlaneEquation K) Polynomial.X, ?_⟩
    change ((cuspParametrization K
      (AdjoinRoot.of (cuspPlaneEquation K) Polynomial.X) : cuspSubalgebra K) :
      Polynomial K) = Polynomial.X ^ 2
    simp only [cuspParametrization_coeff, cuspBaseMap, Polynomial.aeval_X] <;> rfl
  have h3 : (Polynomial.X : Polynomial K) ^ 3 ∈ F.range := by
    refine ⟨AdjoinRoot.root (cuspPlaneEquation K), ?_⟩
    change ((cuspParametrization K
      (AdjoinRoot.root (cuspPlaneEquation K)) : cuspSubalgebra K) :
      Polynomial K) = Polynomial.X ^ 3
    simp only [cuspParametrization_root] <;> rfl
  have hle : cuspSubalgebra K ≤ F.range := by
    apply Algebra.adjoin_le
    intro g hg
    rcases Set.mem_insert_iff.mp hg with hg | hg
    · rw [hg]
      exact h2
    · rw [Set.mem_singleton_iff.mp hg]
      exact h3
  intro z
  obtain ⟨q, hq⟩ := hle z.property
  exact ⟨q, Subtype.ext hq⟩

private theorem cuspParametrization_injective :
    Function.Injective (cuspParametrization K) := by
  rw [injective_iff_map_eq_zero]
  intro q hq
  obtain ⟨f, rfl⟩ := AdjoinRoot.mk_surjective q
  let r := f %ₘ cuspPlaneEquation K
  have hmonic := cuspPlaneEquation_monic K
  have hne : cuspPlaneEquation K ≠ 1 := by
    intro he
    have hd := congrArg Polynomial.natDegree he
    rw [cuspPlaneEquation_natDegree, Polynomial.natDegree_one] at hd
    exact (by decide : (2 : ℕ) ≠ 0) hd
  have hr : r.natDegree < 2 := by
    simpa only [cuspPlaneEquation_natDegree] using Polynomial.natDegree_modByMonic_lt f hmonic hne
  have hlin := eq_linear_polynomial_of_natDegree_lt_two r hr
  have hrem : r.eval₂ (cuspBaseMap K).toRingHom (cuspX3 K) = 0 := by
    exact (Polynomial.eval₂_modByMonic_eq_self_of_root
      (p := f) (cuspPlaneEquation_eval K)).trans ((cuspParametrization_mk K f).symm.trans hq)
  have heval : cuspBaseMap K (r.coeff 0) + cuspBaseMap K (r.coeff 1) * cuspX3 K = 0 := by
    rw [hlin] at hrem
    simp only [Polynomial.eval₂_add, Polynomial.eval₂_C, Polynomial.eval₂_mul,
      Polynomial.eval₂_X] at hrem
    exact hrem
  have hbase (a : Polynomial K) :
      (cuspSubalgebra K).val (cuspBaseMap K a) = Polynomial.expand K 2 a :=
    AlgHom.congr_fun (cuspBaseMap_val K) a
  have hsplit : Polynomial.expand K 2 (r.coeff 0) +
      Polynomial.expand K 2 (r.coeff 1) * Polynomial.X ^ 3 = 0 := by
    have hx3 : (cuspSubalgebra K).val (cuspX3 K) = (Polynomial.X : Polynomial K) ^ 3 := rfl
    simpa only [map_add, map_mul, map_zero, hbase, hx3] using
      congrArg ((cuspSubalgebra K).val) heval
  obtain ⟨h0, h1⟩ := cusp_expanded_linear_eq_zero K _ _ hsplit
  have hrzero : r = 0 := hlin.trans (by simp only [h0, h1, map_zero, zero_mul, zero_add])
  exact AdjoinRoot.mk_eq_zero.mpr ((Polynomial.modByMonic_eq_zero_iff_dvd hmonic).mp hrzero)

/-- The plane cusp \(K[X,Y]/(Y^2-X^3)\) is the coordinate algebra
\(K[t^2,t^3]\) via \(X\mapsto t^2,\ Y\mapsto t^3\). -/
noncomputable def paper2_cusp_coordinate_presentation :
    AdjoinRoot (cuspPlaneEquation K) ≃ₐ[K] cuspSubalgebra K :=
  AlgEquiv.ofBijective (cuspParametrization K)
    ⟨cuspParametrization_injective K, cuspParametrization_surjective K⟩

/-- The constant coefficient map is evaluation at the rational origin of the cusp. -/
def cuspOriginResidue : cuspSubalgebra K →+* K :=
  Polynomial.constantCoeff.comp (cuspSubalgebra K).val.toRingHom

private theorem cuspOriginResidue_surjective :
    Function.Surjective (cuspOriginResidue K) := by
  intro c
  refine ⟨algebraMap K (cuspSubalgebra K) c, ?_⟩
  change (algebraMap K (Polynomial K) c).coeff 0 = c
  rw [← Polynomial.C_eq_algebraMap, Polynomial.coeff_C_zero]

/-- The kernel of evaluation is the maximal ideal of the rational origin. -/
theorem paper2_cusp_origin_isMaximal :
    (RingHom.ker (cuspOriginResidue K)).IsMaximal :=
  RingHom.ker_isMaximal_of_surjective (cuspOriginResidue K) (cuspOriginResidue_surjective K)

/-- The inclusion submodule of the cusp coordinate ring in its normalization. -/
def cuspInclusionSubmodule : Submodule (cuspSubalgebra K) (Polynomial K) where
  carrier := (cuspSubalgebra K : Set (Polynomial K))
  zero_mem' := (cuspSubalgebra K).zero_mem
  add_mem' := (cuspSubalgebra K).add_mem
  smul_mem' a f hf := by
    change (a : Polynomial K) * f ∈ cuspSubalgebra K
    exact (cuspSubalgebra K).mul_mem a.property hf

/-- The actual normalization quotient carries the action through the constant
coefficient. The formula here is the coefficient-one identity on representatives. -/
theorem paper2_cusp_coeff_one_smul (a : cuspSubalgebra K) (f : Polynomial K) :
    (a • f).coeff 1 = cuspOriginResidue K a * f.coeff 1 := by
  have ha : (a : Polynomial K).coeff 1 = 0 :=
    (cusp_mem_iff_coeff_one_zero K _).mp a.property
  change ((a : Polynomial K) * f).coeff 1 = (a : Polynomial K).coeff 0 * f.coeff 1
  rw [Polynomial.mul_coeff_one, ha, zero_mul, add_zero]

private def cuspOriginAlgebra : Algebra (cuspSubalgebra K) K :=
  (cuspOriginResidue K).toAlgebra

attribute [local instance] cuspOriginAlgebra

private def cuspCoeffOne : Polynomial K →ₗ[cuspSubalgebra K] K where
  toFun f := f.coeff 1
  map_add' f g := Polynomial.coeff_add _ _ _
  map_smul' a f := by
    change (a • f).coeff 1 = cuspOriginResidue K a * f.coeff 1
    exact paper2_cusp_coeff_one_smul K a f

private theorem cuspInclusionSubmodule_eq_ker :
    cuspInclusionSubmodule K = (cuspCoeffOne K).ker := by
  ext f
  change f ∈ cuspSubalgebra K ↔ f.coeff 1 = 0
  exact cusp_mem_iff_coeff_one_zero K f

private def cuspQuotientCoeffEquiv :
    (Polynomial K ⧸ cuspInclusionSubmodule K) ≃ₗ[cuspSubalgebra K] K := by
  rw [cuspInclusionSubmodule_eq_ker]
  refine (cuspCoeffOne K).quotKerEquivOfSurjective ?_
  intro c
  exact ⟨Polynomial.monomial 1 c, by simp [cuspCoeffOne]⟩

/-- The normalization quotient is the residue module at the origin, over the
cusp coordinate ring itself. -/
noncomputable def paper2_cusp_quotient_residue_linear_equiv :
    (Polynomial K ⧸ cuspInclusionSubmodule K) ≃ₗ[cuspSubalgebra K]
      (cuspSubalgebra K ⧸ RingHom.ker (cuspOriginResidue K)) := by
  let e := (cuspOriginResidue K).quotientKerEquivOfSurjective (cuspOriginResidue_surjective K)
  let eₐ : (cuspSubalgebra K ⧸ RingHom.ker (cuspOriginResidue K)) ≃ₐ[cuspSubalgebra K] K :=
    AlgEquiv.ofRingEquiv (f := e) (by
      intro a
      exact RingHom.quotientKerEquivOfSurjective_apply_mk (cuspOriginResidue_surjective K) a)
  exact (cuspQuotientCoeffEquiv K).trans eₐ.toLinearEquiv.symm

/-- Every scalar outside the origin ideal acts invertibly on the normalization quotient. -/
theorem paper2_cusp_nonzero_residue_smul_bijective (a : cuspSubalgebra K)
    (ha : cuspOriginResidue K a ≠ 0) :
    Function.Bijective (fun z : Polynomial K ⧸ cuspInclusionSubmodule K => a • z) := by
  let e := cuspQuotientCoeffEquiv K
  constructor
  · intro x y h
    have hs : a • e x = a • e y := by
      simpa only [map_smul] using congrArg e h
    change cuspOriginResidue K a * e x = cuspOriginResidue K a * e y at hs
    exact e.injective (mul_left_cancel₀ ha hs)
  · intro y
    refine ⟨e.symm ((cuspOriginResidue K a)⁻¹ * e y), ?_⟩
    apply e.injective
    rw [map_smul, e.apply_symm_apply]
    change cuspOriginResidue K a * ((cuspOriginResidue K a)⁻¹ * e y) = e y
    rw [← mul_assoc, mul_inv_cancel₀ ha, one_mul]

/-- The conductor of the cusp coordinate ring in its polynomial
normalization is the ideal generated by the square of the parameter. -/
theorem paper2_cusp_conductor_eq_square :
    conductor (cuspSubalgebra K) (0 : Polynomial K) =
      Ideal.span {((X : Polynomial K) ^ 2)} := by
  ext f
  rw [mem_conductor_iff, Ideal.mem_span_singleton, Polynomial.X_pow_dvd_iff]
  simp only [Algebra.adjoin_singleton_zero, Algebra.mem_bot, Set.mem_range]
  have hc (g : Polynomial K) :
      (∃ a : cuspSubalgebra K, algebraMap (cuspSubalgebra K) (Polynomial K) a = g) ↔
        g.coeff 1 = 0 := by
    constructor
    · rintro ⟨a, rfl⟩
      exact (cusp_mem_iff_coeff_one_zero K a).mp a.property
    · intro hg
      exact ⟨⟨g, (cusp_mem_iff_coeff_one_zero K g).mpr hg⟩, rfl⟩
  simp only [hc]
  constructor
  · intro h d hd
    have h0 := h (X : Polynomial K)
    have h1 := h 1
    rw [Polynomial.coeff_mul_X f 0] at h0
    rw [mul_one] at h1
    have hcases : d = 0 ∨ d = 1 := by omega
    rcases hcases with rfl | rfl
    · exact h0
    · exact h1
  · intro h g
    have hf : (X : Polynomial K) ^ 2 ∣ f := Polynomial.X_pow_dvd_iff.mpr h
    exact (Polynomial.X_pow_dvd_iff.mp (dvd_mul_of_dvd_left hf g)) 1 (by decide)

/-- The conductor cuts out the origin on the cusp. -/
theorem paper2_cusp_conductor_comap_eq_origin :
    Ideal.comap (algebraMap (cuspSubalgebra K) (Polynomial K))
      (conductor (cuspSubalgebra K) (0 : Polynomial K)) =
        RingHom.ker (cuspOriginResidue K) := by
  ext a
  rw [Ideal.mem_comap, paper2_cusp_conductor_eq_square, Ideal.mem_span_singleton,
    Polynomial.X_pow_dvd_iff, RingHom.mem_ker]
  change (∀ d < 2, (a : Polynomial K).coeff d = 0) ↔ (a : Polynomial K).coeff 0 = 0
  constructor
  · intro h
    exact h 0 (by decide)
  · intro h d hd
    have hcases : d = 0 ∨ d = 1 := by omega
    rcases hcases with rfl | rfl
    · exact h
    · exact (cusp_mem_iff_coeff_one_zero K a).mp a.property

private abbrev cuspSquareQuotient (K : Type*) [Field K] :=
  Polynomial K ⧸ Ideal.span {((X : Polynomial K) ^ 2)}

private def cuspSquareReduction : Polynomial K →+* cuspSquareQuotient K :=
  Ideal.Quotient.mk _

private theorem cusp_square_reduction_eq_constant_iff (f : Polynomial K) (c : K) :
    cuspSquareReduction K f = cuspSquareReduction K (C c) ↔
      f.coeff 0 = c ∧ f.coeff 1 = 0 := by
  rw [cuspSquareReduction, Ideal.Quotient.eq, Ideal.mem_span_singleton,
    Polynomial.X_pow_dvd_iff]
  constructor
  · intro h
    have h0 := h 0 (by decide)
    have h1 := h 1 (by decide)
    exact ⟨sub_eq_zero.mp (by simpa using h0), by simpa using h1⟩
  · rintro ⟨h0, h1⟩ d hd
    have hcases : d = 0 ∨ d = 1 := by omega
    rcases hcases with rfl | rfl <;> simp [h0, h1]

/-- The pullback of the square-zero quotient map along the inclusion of
constants. This pairs a polynomial with a constant of the same reduction. -/
def cuspConductorPullback : Subring (Polynomial K × K) :=
  ((cuspSquareReduction K).comp (RingHom.fst (Polynomial K) K)).eqLocus
    (((cuspSquareReduction K).comp Polynomial.C).comp (RingHom.snd (Polynomial K) K))

private def cuspConductorToPullback : cuspSubalgebra K →+* cuspConductorPullback K := by
  let f := (algebraMap (cuspSubalgebra K) (Polynomial K)).prod (cuspOriginResidue K)
  refine {
    toFun := fun a => ⟨f a, ?_⟩
    map_one' := Subtype.ext f.map_one
    map_mul' := fun a b => Subtype.ext (f.map_mul a b)
    map_zero' := Subtype.ext f.map_zero
    map_add' := fun a b => Subtype.ext (f.map_add a b)
  }
  change cuspSquareReduction K (a : Polynomial K) =
    cuspSquareReduction K (C (cuspOriginResidue K a))
  apply (cusp_square_reduction_eq_constant_iff K _ _).2
  exact ⟨rfl, (cusp_mem_iff_coeff_one_zero K a).mp a.property⟩

/-- The cusp ring is the conductor pullback
`K[t] ×_{K[t]/(t²)} K`. -/
noncomputable def paper2_cusp_conductor_pullback_equiv :
    cuspSubalgebra K ≃+* cuspConductorPullback K := by
  apply RingEquiv.ofBijective (cuspConductorToPullback K)
  constructor
  · intro a b h
    exact Subtype.ext (congrArg (fun c : cuspConductorPullback K =>
      (c : Polynomial K × K).1) h)
  · rintro ⟨⟨f, c⟩, h⟩
    change cuspSquareReduction K f = cuspSquareReduction K (C c) at h
    obtain ⟨h0, h1⟩ := (cusp_square_reduction_eq_constant_iff K f c).1 h
    refine ⟨⟨f, (cusp_mem_iff_coeff_one_zero K f).2 h1⟩, Subtype.ext ?_⟩
    exact Prod.ext rfl h0

end

end ManuscriptAudit.CuspDelta

open Lean Elab Command in
run_cmd do
  let allowed : List Name := [``propext, ``Classical.choice, ``Quot.sound]
  for name in [
      ``ManuscriptAudit.CuspDelta.paper2_cusp_delta_coordinate_quotient_finrank,
      ``ManuscriptAudit.CuspDelta.paper2_cusp_inclusion_finite,
      ``ManuscriptAudit.CuspDelta.paper2_cusp_inclusion_integral,
      ``ManuscriptAudit.CuspDelta.paper2_cusp_fraction_field,
      ``ManuscriptAudit.CuspDelta.paper2_cusp_polynomial_is_integral_closure,
      ``ManuscriptAudit.CuspDelta.paper2_cusp_field_points_bijective,
      ``ManuscriptAudit.CuspDelta.cusp_expanded_linear_eq_zero,
      ``ManuscriptAudit.CuspDelta.paper2_cusp_coordinate_presentation,
      ``ManuscriptAudit.CuspDelta.paper2_cusp_origin_isMaximal,
      ``ManuscriptAudit.CuspDelta.paper2_cusp_coeff_one_smul,
      ``ManuscriptAudit.CuspDelta.paper2_cusp_quotient_residue_linear_equiv,
      ``ManuscriptAudit.CuspDelta.paper2_cusp_nonzero_residue_smul_bijective,
      ``ManuscriptAudit.CuspDelta.paper2_cusp_conductor_eq_square,
      ``ManuscriptAudit.CuspDelta.paper2_cusp_conductor_comap_eq_origin,
      ``ManuscriptAudit.CuspDelta.paper2_cusp_conductor_pullback_equiv] do
    let dependencies ← collectAxioms name
    let unexpected := dependencies.filter fun axiomName => !allowed.contains axiomName
    unless unexpected.isEmpty do
      throwError m!"{name} depends on unexpected axioms {unexpected}"
    logInfo m!"{name} uses {dependencies}"

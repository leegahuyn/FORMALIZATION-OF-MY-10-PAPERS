import Lean.Elab.BuiltinEvalCommand
import Lean.Util.CollectAxioms
import Mathlib.RingTheory.TensorProduct.Maps
import PrimalitySheafVerification.ManuscriptAudit.CuspDelta
import PrimalitySheafVerification.ManuscriptAudit.CuspPunctured

/-!
# The two cusp reductions after base change

The normalization and constant-term maps to the square-zero neighborhood
of the origin are cusp-algebra maps. Tensoring with a cusp algebra gives
two maps whose reduction modulo the square-zero ideal generated by
the base-changed origin coordinate agrees.
-/

namespace ManuscriptAudit.CuspReductionBaseChange

open CuspDelta CuspPunctured Polynomial TensorProduct

noncomputable section

variable (K : Type*) [Field K]

/-- The cusp acts on the square-zero quotient through polynomial reduction. -/
def squareQuotientAlgebra : Algebra (CuspSubalgebra K) (cuspSquareQuotient K) :=
  ((cuspSquareReduction K).comp (algebraMap (CuspSubalgebra K) (Polynomial K))).toAlgebra

attribute [local instance] squareQuotientAlgebra

/-- Polynomial reduction as a homomorphism of cusp algebras. -/
def reductionAlg : Polynomial K →ₐ[CuspSubalgebra K] cuspSquareQuotient K :=
  { cuspSquareReduction K with commutes' := fun _ => rfl }

/-- Taking the constant term and then reducing as a cusp-algebra homomorphism. -/
def constantReductionAlg : Polynomial K →ₐ[CuspSubalgebra K] cuspSquareQuotient K :=
  { (cuspSquareReduction K).comp (C.comp Polynomial.constantCoeff) with
    commutes' := fun a => by
      change cuspSquareReduction K (C ((a : Polynomial K).coeff 0)) =
        cuspSquareReduction K (a : Polynomial K)
      exact ((cusp_square_reduction_eq_constant_iff K _ _).2
        ⟨rfl, (cusp_mem_iff_coeff_one_zero K _).1 a.property⟩).symm }

private theorem reduction_X_square : (reductionAlg K (X : Polynomial K)) ^ 2 = 0 := by
  rw [← map_pow]
  change Ideal.Quotient.mk (Ideal.span {((X : Polynomial K) ^ 2)}) (X ^ 2) = 0
  exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton _))

variable (T : Type*) [CommRing T] [Algebra (CuspSubalgebra K) T]

/-- Base change of polynomial reduction to a cusp algebra. -/
def flatReductionAlg :
    T ⊗[CuspSubalgebra K] Polynomial K →ₐ[T] T ⊗[CuspSubalgebra K] cuspSquareQuotient K :=
  Algebra.TensorProduct.map (AlgHom.id T T) (reductionAlg K)

/-- Base change of constant-term reduction to the same cusp algebra. -/
def flatConstantReductionAlg :
    T ⊗[CuspSubalgebra K] Polynomial K →ₐ[T] T ⊗[CuspSubalgebra K] cuspSquareQuotient K :=
  Algebra.TensorProduct.map (AlgHom.id T T) (constantReductionAlg K)

@[simp] theorem flatReductionAlg_tmul (t : T) (f : Polynomial K) :
    flatReductionAlg K T (t ⊗ₜ[CuspSubalgebra K] f) =
      t ⊗ₜ[CuspSubalgebra K] reductionAlg K f := by
  rw [flatReductionAlg, Algebra.TensorProduct.map_tmul, AlgHom.id_apply]

@[simp] theorem flatConstantReductionAlg_tmul (t : T) (f : Polynomial K) :
    flatConstantReductionAlg K T (t ⊗ₜ[CuspSubalgebra K] f) =
      t ⊗ₜ[CuspSubalgebra K] constantReductionAlg K f := by
  rw [flatConstantReductionAlg, Algebra.TensorProduct.map_tmul, AlgHom.id_apply]

/-- The ideal generated by the base-changed origin coordinate. -/
def baseChangedOriginIdeal : Ideal (T ⊗[CuspSubalgebra K] cuspSquareQuotient K) :=
  Ideal.span {(1 : T) ⊗ₜ[CuspSubalgebra K] reductionAlg K (X : Polynomial K)}

/-- The base-changed origin ideal is square zero. -/
theorem baseChangedOriginIdeal_square : (baseChangedOriginIdeal K T) ^ 2 = ⊥ := by
  rw [baseChangedOriginIdeal, Ideal.span_singleton_pow, Ideal.span_singleton_eq_bot, pow_two,
    Algebra.TensorProduct.tmul_mul_tmul, one_mul, ← pow_two, reduction_X_square,
    TensorProduct.tmul_zero]

/-- The two reductions after base change agree modulo the same square-zero ideal. -/
theorem flatReduction_equal_mod_origin :
    (Ideal.Quotient.mkₐ T (baseChangedOriginIdeal K T)).comp (flatReductionAlg K T) =
      (Ideal.Quotient.mkₐ T (baseChangedOriginIdeal K T)).comp (flatConstantReductionAlg K T) := by
  apply AlgHom.ext
  intro z
  induction z using TensorProduct.induction_on with
  | zero => simp only [map_zero]
  | tmul t f =>
    change Ideal.Quotient.mk (baseChangedOriginIdeal K T) (flatReductionAlg K T (t ⊗ₜ f)) =
      Ideal.Quotient.mk (baseChangedOriginIdeal K T) (flatConstantReductionAlg K T (t ⊗ₜ f))
    rw [flatReductionAlg_tmul, flatConstantReductionAlg_tmul]
    apply Ideal.Quotient.eq.mpr
    rw [← TensorProduct.tmul_sub]
    have h : X ∣ f - C (f.coeff 0) := by
      rw [Polynomial.X_dvd_iff, Polynomial.coeff_sub, Polynomial.coeff_C_zero, sub_self]
    obtain ⟨q, hq⟩ := h
    have hc : constantReductionAlg K f = reductionAlg K (C (f.coeff 0)) := rfl
    rw [hc, ← map_sub, hq, map_mul]
    have ht : (t ⊗ₜ[CuspSubalgebra K] (reductionAlg K X * reductionAlg K q)) =
        ((1 : T) ⊗ₜ[CuspSubalgebra K] reductionAlg K X) *
          (t ⊗ₜ[CuspSubalgebra K] reductionAlg K q) := by
      rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul]
    rw [ht]
    exact (baseChangedOriginIdeal K T).mul_mem_right _ (Ideal.subset_span (Set.mem_singleton _))
  | add x y hx hy => simp only [map_add, hx, hy]

end

end ManuscriptAudit.CuspReductionBaseChange

open Lean Elab Command in
run_cmd do
  let allowed : List Name := [``propext, ``Classical.choice, ``Quot.sound]
  for name in [``ManuscriptAudit.CuspReductionBaseChange.reductionAlg,
      ``ManuscriptAudit.CuspReductionBaseChange.constantReductionAlg,
      ``ManuscriptAudit.CuspReductionBaseChange.baseChangedOriginIdeal_square,
      ``ManuscriptAudit.CuspReductionBaseChange.flatReduction_equal_mod_origin] do
    let dependencies ← collectAxioms name
    let unexpected := dependencies.filter fun axiomName => !allowed.contains axiomName
    unless unexpected.isEmpty do
      throwError m!"{name} depends on unexpected axioms {unexpected}"
    logInfo m!"{name} uses {dependencies}"

import Lean.Util.CollectAxioms
import PrimalitySheafVerification.ManuscriptAudit.NodalNormalizedNativeOverlapCokernel
import PrimalitySheafVerification.ManuscriptAudit.NodalNormalizedNativeHTwoBoundary
import PrimalitySheafVerification.ManuscriptAudit.MayerVietorisSecondCokernel
import PrimalitySheafVerification.ManuscriptAudit.ProetaleKummerCyclicCoordinates
import PrimalitySheafVerification.ManuscriptAudit.ProetaleAffineLineCyclicHOne

/-! The normalized node's actual finite native degree-two cohomology
is cyclic. Its quotient coordinate is the native overlap order. -/

namespace ManuscriptAudit.NodalNormalizedNativeFiniteHTwo

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite
open ProetaleMayerVietorisSite (openCoverSquare sheafEquivalence)
open ProetaleHighOpenCohomology (openEquiv terminalEquiv liftedObject)
open ProetaleAdicHOneDetection (finiteCoefficient)
open ProetaleOpenLocalLifts (openObject)
open ProetaleCohomologyIso (cohomologyIso)
open ProetaleClosedOpenRestriction (restrictionFunctionsIso)
open ProetaleDiscreteConstant (nativeResidueIso)
open ProetaleKummerSequence (sequence constantKernelIso)
open ProetaleKummerCyclicCoordinates (cyclicIso)
open NodalProjectiveNormalization (normalizedNode)
open NodalNormalizedNativeCharts (yToNormalized zToNormalized)
open NodalNormalizedNativeHTwoBoundary (overlapOpen firstLeg secondLeg overlap cover y_HTwo_subsingleton)
open NodalYChartPrincipalOpen (principalRingHom)
open NodalNormalizedNativeOverlapCokernel (baseMap restriction cokernelEquiv)
open NativeKummerChartBoundaryPresentation (chartArrow)

noncomputable section

set_option backward.defeqAttrib.useBackward true
set_option backward.isDefEq.respectTransparency false

variable (K : Type) [Field K] [IsAlgClosed K] (h₂ : (2 : K) ≠ 0)
  (l r : ℕ) [Fact l.Prime] [NeZero (l : K)]

private abbrev A := AddCommGrpCat.{1}
private abbrev X := normalizedNode K
private abbrev Y := yToNormalized K
private abbrev Z := zToNormalized K h₂
private abbrev d := l ^ r

local instance residueTopology (n : ℕ) : TopologicalSpace (ZMod n) := ⊥
local instance residueDiscrete (n : ℕ) : DiscreteTopology (ZMod n) := ⟨rfl⟩

local instance residueOrder : NeZero (d l r) :=
  ⟨pow_ne_zero _ (Fact.out : Nat.Prime l).ne_zero⟩

local instance castResidueOrder : NeZero ((d l r : ℕ) : K) :=
  ⟨by rw [d, Nat.cast_pow]; exact pow_ne_zero r (NeZero.ne (l : K))⟩

private abbrev rootSheaf := (sequence (X K) (d l r)).X₁
private abbrev F := NodalNormalizedNativeOverlapCokernel.F K (d l r)

private def rootIso : finiteCoefficient (X K) l r ≅ rootSheaf K l r :=
  (nativeResidueIso (X K) l r).symm ≪≫
    (constantSheaf (Scheme.ProEt.topology (X K)) A).mapIso (cyclicIso K l r) ≪≫
    constantKernelIso (baseMap K) (d l r)

private def chartEquiv {U : Scheme.{0}} (j : U ⟶ X K) [IsOpenImmersion j] (n : ℕ) :
    (F K l r).H' n (liftedObject (openObject j)) ≃+
      Sheaf.H (finiteCoefficient U l r) n :=
  (openEquiv j (rootSheaf K l r) n).trans
    (cohomologyIso ((OpenProetaleExtension.restriction j A).mapIso (rootIso K l r).symm ≪≫
      restrictionFunctionsIso j (ZMod (d l r))) n)

private abbrev square :=
  openCoverSquare (Z K h₂) (Y K) (overlapOpen K) (secondLeg K h₂) (firstLeg K)
    (overlap K h₂).flip ((Set.union_comm _ _).trans (cover K h₂))

private theorem z_HOne : Subsingleton (Sheaf.H
    (finiteCoefficient (Spec (CommRingCat.of (Polynomial K))) l r) 1) := by
  let U := Spec (CommRingCat.of (Polynomial K))
  let e := cohomologyIso (nativeResidueIso U l r) 1
  have h := ProetaleAffineLineCyclicHOne.affineLine_HOne_subsingleton K (d l r)
  exact ⟨fun a b ↦ e.symm.injective (h.elim (e.symm a) (e.symm b))⟩

private theorem first_zero :
    (((F K l r).cohomologyPresheaf 1).map (square K h₂).f₁₂.op).hom = 0 := by
  let e := chartEquiv K l r (Z K h₂) 1
  have h : Subsingleton ((F K l r).H' 1 (square K h₂).X₂) :=
    ⟨fun x y ↦ e.injective ((z_HOne K l r).elim _ _)⟩
  ext x
  have hx : x = 0 := h.elim _ _
  rw [hx, map_zero, AddMonoidHom.zero_apply]

private theorem second_eq :
    (((F K l r).cohomologyPresheaf 1).map (square K h₂).f₁₃.op).hom =
      restriction K (d l r) := by
  have h : firstLeg K = chartArrow (Y K) (principalRingHom K) := by
    apply MorphismProperty.Over.Hom.ext
    rfl
  change (((F K l r).cohomologyPresheaf 1).map
    ((ProetaleMayerVietorisSite.siteEquivalence (X K)).functor.map (firstLeg K)).op).hom = _
  rw [h] <;> rfl

set_option maxHeartbeats 6200000 in
/-- The genuine normalized finite residue group is generated by the order coordinate. -/
def finiteEquiv : ZMod (d l r) ≃+ Sheaf.H (finiteCoefficient (X K) l r) 2 := by
  let eZ := chartEquiv K l r (Z K h₂) 2
  let eY := chartEquiv K l r (Y K) 2
  have hz := AffineLineNativeResidueHTwo.native_residue_HTwo_subsingleton K l r
  have hy := y_HTwo_subsingleton K l r
  have hZ : Subsingleton ((F K l r).H' 2 (square K h₂).X₂) :=
    ⟨fun x y ↦ eZ.injective (hz.elim _ _)⟩
  have hY : Subsingleton ((F K l r).H' 2 (square K h₂).X₃) :=
    ⟨fun x y ↦ eY.injective (hy.elim _ _)⟩
  let e := MayerVietorisSecondCokernel.cokernelEquiv (square K h₂) (F K l r) 1
    (first_zero K h₂ l r) hZ hY
  have c : (((F K l r).H' 1 (square K h₂).X₁ : Type 1) ⧸ (restriction K (d l r)).range) ≃+
      (F K l r).H' 2 (square K h₂).X₄ := by
    rw [← second_eq K h₂ l r]
    exact e
  exact (cokernelEquiv K (d l r)).symm.trans (c.trans
    ((terminalEquiv (rootSheaf K l r) 2).trans (cohomologyIso (rootIso K l r).symm 2)))

end
end ManuscriptAudit.NodalNormalizedNativeFiniteHTwo

open Lean Elab Command in
run_cmd do
  let name := ``ManuscriptAudit.NodalNormalizedNativeFiniteHTwo.finiteEquiv
  let ax ← collectAxioms name
  let allowed : List Name := [``propext, ``Classical.choice, ``Quot.sound]
  unless ax.all (fun a ↦ allowed.contains a) do
    throwError m!"{name} depends on unexpected axioms {ax}"
  logInfo m!"{name} uses {ax}"

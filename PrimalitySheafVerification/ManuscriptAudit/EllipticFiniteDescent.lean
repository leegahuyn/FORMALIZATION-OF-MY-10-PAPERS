import Lean.Util.CollectAxioms
import Mathlib.AlgebraicGeometry.EllipticCurve.Affine.Point
import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
import Mathlib.RingTheory.Finiteness.Cardinality

/-!
For the geometric torsion question in Paper 5, a point over an algebraic
extension descends to the finite extension generated by its affine coordinates.
The same descent respects multiplication by any natural number.
-/

namespace ManuscriptAudit.EllipticFiniteDescent

open WeierstrassCurve

noncomputable section

variable {F L : Type*} [Field F] [Field L] [Algebra F L] [DecidableEq L]

local instance (E : IntermediateField F L) : DecidableEq E :=
  inferInstanceAs (DecidableEq {x : L // x ∈ E})

variable [Algebra.IsAlgebraic F L]

/-- A nonsingular point is defined over a finite intermediate extension. -/
theorem point_descends_finite (W : Affine F) (P : (W.baseChange L).Point) :
    ∃ E : IntermediateField F L, FiniteDimensional F E ∧
      ∃ Q : (W.baseChange E).Point, Affine.Point.map (W' := W) E.val Q = P := by
  cases P with
  | zero =>
    let E : IntermediateField F L := ⊥
    have hE : FiniteDimensional F E :=
      (IntermediateField.botEquiv F L).symm.toLinearEquiv.finiteDimensional
    exact ⟨E, hE, .zero, rfl⟩
  | some x y h =>
    let E : IntermediateField F L := IntermediateField.adjoin F ({x, y} : Set L)
    have hE : FiniteDimensional F E :=
      IntermediateField.finiteDimensional_adjoin_pair
        (Algebra.IsIntegral.isIntegral (R := F) x)
        (Algebra.IsIntegral.isIntegral (R := F) y)
    let x₀ : E := IntermediateField.AdjoinPair.gen₁ F x y
    let y₀ : E := IntermediateField.AdjoinPair.gen₂ F x y
    have hx : E.val x₀ = x := rfl
    have hy : E.val y₀ = y := rfl
    have h₀ : (W.baseChange E).Nonsingular x₀ y₀ :=
      (W.baseChange_nonsingular (f := E.val) E.val.injective x₀ y₀).mp
        (by simpa only [hx, hy] using h)
    exact ⟨E, hE, .some x₀ y₀ h₀, rfl⟩

/-- A nonidentity torsion point descends together with its torsion relation. -/
theorem nonzero_torsion_descends_finite (W : Affine F) (n : ℕ)
    (P : (W.baseChange L).Point) (hP : n • P = 0) (hne : P ≠ 0) :
    ∃ E : IntermediateField F L, FiniteDimensional F E ∧
      ∃ Q : (W.baseChange E).Point,
        n • Q = 0 ∧ Q ≠ 0 ∧ Affine.Point.map (W' := W) E.val Q = P := by
  obtain ⟨E, hE, Q, hQ⟩ := point_descends_finite W P
  let f : (W.baseChange E).Point →+ (W.baseChange L).Point :=
    Affine.Point.map (W' := W) E.val
  change f Q = P at hQ
  have htor : n • Q = 0 := by
    apply Affine.Point.map_injective (W' := W) E.val
    change f (n • Q) = f 0
    rw [map_nsmul, hQ, hP, map_zero]
  have hnonzero : Q ≠ 0 := by
    intro he
    rw [he, map_zero] at hQ
    exact hne hQ.symm
  exact ⟨E, hE, Q, htor, hnonzero, hQ⟩

/-- Vanishing over the finite intermediate extensions implies vanishing
over the algebraic extension. -/
theorem torsion_eq_zero_of_finite_extensions (W : Affine F) (n : ℕ)
    (h : ∀ (E : IntermediateField F L), FiniteDimensional F E →
      ∀ Q : (W.baseChange E).Point, n • Q = 0 → Q = 0)
    (P : (W.baseChange L).Point) (hP : n • P = 0) : P = 0 := by
  by_contra hne
  obtain ⟨E, hE, Q, htor, hQ, _⟩ :=
    nonzero_torsion_descends_finite W n P hP hne
  exact hQ (h E hE Q htor)

/-- Over a finite base field the intermediate fields needed in the
descent are finite sets. -/
theorem torsion_eq_zero_of_finite_fields [Finite F] (W : Affine F) (n : ℕ)
    (h : ∀ (E : IntermediateField F L), Finite E →
      ∀ Q : (W.baseChange E).Point, n • Q = 0 → Q = 0)
    (P : (W.baseChange L).Point) (hP : n • P = 0) : P = 0 := by
  apply torsion_eq_zero_of_finite_extensions W n _ P hP
  intro E hE Q hQ
  letI : FiniteDimensional F E := hE
  exact h E (Module.finite_of_finite F) Q hQ

end

open Lean Elab Command in
run_cmd do
  let allowed : List Name := [``propext, ``Classical.choice, ``Quot.sound]
  for name in [``point_descends_finite, ``nonzero_torsion_descends_finite,
      ``torsion_eq_zero_of_finite_extensions, ``torsion_eq_zero_of_finite_fields] do
    let dependencies ← collectAxioms name
    let unexpected := dependencies.filter fun axiomName => !allowed.contains axiomName
    unless unexpected.isEmpty do
      throwError m!"{name} depends on unexpected axioms {unexpected}"
    logInfo m!"{name} uses {dependencies}"

end ManuscriptAudit.EllipticFiniteDescent

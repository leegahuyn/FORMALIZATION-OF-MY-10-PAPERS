import Lean.Util.CollectAxioms
import Mathlib.AlgebraicGeometry.OpenImmersion
import PrimalitySheafVerification.ManuscriptAudit.WeierstrassProperInfinityChart
import PrimalitySheafVerification.ManuscriptAudit.WeierstrassInfinityPuncture
import PrimalitySheafVerification.ManuscriptAudit.WeierstrassProjectiveInfinity

/-! The unique boundary of the actual proper Weierstrass curve is a rational
closed point. Its ideal is generated by a non-zero-divisor on an open neighborhood. -/

namespace ManuscriptAudit.WeierstrassCartierInfinity

open AlgebraicGeometry CategoryTheory
open WeierstrassProjectiveClosure WeierstrassInfinityChartAlgebra
open WeierstrassInfinityOriginIdeal
open CuspProperCompactification (affineZChartι)
open CuspYChartAlgebra (grading X_mem_one)
open scoped nonZeroDivisors

universe u

noncomputable section

set_option backward.defeqAttrib.useBackward true
set_option backward.isDefEq.respectTransparency false

attribute [local instance] MvPolynomial.gradedAlgebra

variable {K : Type u} [Field K] (W : WeierstrassCurve.Affine K)

private abbrev linePoint := Spec (CommRingCat.of K)

def originToChart : linePoint (K := K) ⟶ WeierstrassInfinityChartImmersion.chartScheme W :=
  Spec.map (CommRingCat.ofHom (origin W).toRingHom)

/-- The actual rational point added to the affine Weierstrass equation. -/
def atInfinity : linePoint (K := K) ⟶ projectiveScheme W :=
  originToChart W ≫ WeierstrassProperInfinityChart.chartOpen W

private theorem origin_surjective : Function.Surjective (origin W) := by
  intro c
  exact ⟨algebraMap K (Ring W) c, (origin W).commutes c⟩

private instance originToChart_isClosedImmersion : IsClosedImmersion (originToChart W) :=
  IsClosedImmersion.spec_of_surjective _ (origin_surjective W)

private theorem origin_preimage_affine :
    (atInfinity W) ⁻¹ᵁ (affineOpen W).opensRange = ⊥ := by
  have hZ : (WeierstrassProperInfinityChart.chartOpen W) ⁻¹ᵁ (affineOpen W).opensRange =
      PrimeSpectrum.basicOpen (z W) := by
    rw [WeierstrassInfinityPuncture.affineOpen_range_z, ← Scheme.Hom.comp_preimage,
      WeierstrassProperInfinityChart.chartOpen_inPlane, WeierstrassInfinityChartImmersion.inPlane_preimage_z]
  rw [atInfinity, Scheme.Hom.comp_preimage, hZ, originToChart, SpecMap_preimage_basicOpen]
  change PrimeSpectrum.basicOpen (origin W (z W)) = ⊥
  rw [origin_z, PrimeSpectrum.basicOpen_zero]

theorem atInfinity_outside_affine (p : linePoint (K := K)) :
    atInfinity W p ∉ Set.range (affineOpen W) := by
  intro hp
  have h : p ∈ (atInfinity W) ⁻¹ᵁ (affineOpen W).opensRange := hp
  rw [origin_preimage_affine] at h
  exact h

theorem range_atInfinity : Set.range (atInfinity W) = (Set.range (affineOpen W))ᶜ := by
  obtain ⟨q, -, hq⟩ := WeierstrassProjectiveInfinity.existsUnique_boundary W
  apply Set.Subset.antisymm
  · rintro x ⟨p, rfl⟩
    exact atInfinity_outside_affine W p
  · intro x hx
    let p : linePoint (K := K) := (⊥ : PrimeSpectrum K)
    exact ⟨p, (hq _ (atInfinity_outside_affine W p)).trans (hq x hx).symm⟩

/-- The unique infinity point is an actual closed immersion of the ground field. -/
theorem atInfinity_isClosedImmersion : IsClosedImmersion (atInfinity W) := by
  letI : IsImmersion (atInfinity W) := by
    unfold atInfinity
    infer_instance
  apply IsClosedImmersion.of_isPreimmersion
  rw [range_atInfinity]
  exact (affineOpen W).isOpenEmbedding.isOpen_range.isClosed_compl

theorem originToNeighborhood_fac : originToNeighborhood W ≫ neighborhoodOpen W = atInfinity W := by
  unfold originToNeighborhood neighborhoodOpen neighborhoodToChart atInfinity originToChart
  rw [← Category.assoc, ← Spec.map_comp]
  have h : CommRingCat.ofHom (algebraMap (Ring W) (Neighborhood W)) ≫
      CommRingCat.ofHom (localOrigin W).toRingHom = CommRingCat.ofHom (origin W).toRingHom := by
    apply CommRingCat.hom_ext
    apply RingHom.ext
    exact localOrigin_map W
  rw [h]


end

end ManuscriptAudit.WeierstrassCartierInfinity

open Lean Elab Command in
run_cmd do
  let allowed : List Name := [``propext, ``Classical.choice, ``Quot.sound]
  for name in [``ManuscriptAudit.WeierstrassCartierInfinity.range_atInfinity,
      ``ManuscriptAudit.WeierstrassCartierInfinity.atInfinity_isClosedImmersion,
      ``ManuscriptAudit.WeierstrassCartierInfinity.neighborhoodOpen_isOpenImmersion,
      ``ManuscriptAudit.WeierstrassCartierInfinity.originToNeighborhood_fac,
      ``ManuscriptAudit.WeierstrassCartierInfinity.cartier_parameter] do
    let ax ← collectAxioms name
    let bad := ax.filter fun n => !allowed.contains n
    unless bad.isEmpty do
      throwError m!"{name} depends on unexpected axioms {bad}"
    logInfo m!"{name} uses {ax}"

import Lean.Util.CollectAxioms
import Mathlib.Algebra.Category.Ring.Under.Basic
import PrimalitySheafVerification.ManuscriptAudit.NativeEtaleSingletonSectionGluing
import PrimalitySheafVerification.ManuscriptAudit.NativeAffineEtaleStageSections

/-! Matching of sections over finite algebra models is literal étale
sheaf gluing on the affine cover and its actual self-intersection. -/

namespace ManuscriptAudit.NativeEtaleUnderRingGluing

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite
open ProetaleAffineTensor (spectrum)

noncomputable section

set_option backward.defeqAttrib.useBackward true
set_option backward.isDefEq.respectTransparency false

universe u

variable {A : Type u} [CommRing A]

private abbrev R := CommRingCat.of A
private abbrev X := spectrum A

abbrev obj (U : Under (R (A := A))) [Etale (Spec.map U.hom)] : (X (A := A)).Etale :=
  Scheme.Etale.mk (Spec.map U.hom)

abbrev arrow {U V : Under (R (A := A))}
    [Etale (Spec.map U.hom)] [Etale (Spec.map V.hom)] (f : U ⟶ V) : obj V ⟶ obj U :=
  MorphismProperty.Over.homMk (Spec.map f.right) (by
    change Spec.map f.right ≫ Spec.map U.hom = Spec.map V.hom
    rw [← Spec.map_comp, Under.w f])

theorem arrow_comp {U V W : Under (R (A := A))}
    [Etale (Spec.map U.hom)] [Etale (Spec.map V.hom)] [Etale (Spec.map W.hom)]
    (a : U ⟶ V) (b : V ⟶ W) : arrow b ≫ arrow a = arrow (a ≫ b) := by
  apply MorphismProperty.Over.Hom.ext
  exact (Spec.map_comp a.right b.right).symm

private theorem under_isPullback {U V W Z : (X (A := A)).Etale}
    {a : U ⟶ V} {b : U ⟶ W} {f : V ⟶ Z} {g : W ⟶ Z}
    (h : IsPullback a.left b.left f.left g.left) : IsPullback a b f g := by
  refine IsPullback.mk' (MorphismProperty.Over.Hom.ext h.w) ?_ ?_
  · intro T i j h₁ h₂
    apply MorphismProperty.Over.Hom.ext
    exact h.hom_ext (congrArg (fun t : T ⟶ V ↦ t.left) h₁)
      (congrArg (fun t : T ⟶ W ↦ t.left) h₂)
  · intro T i j hij
    have hc := congrArg (fun t : T ⟶ Z ↦ t.left) hij
    let l := h.lift i.left j.left hc
    have hw : l ≫ U.hom = T.hom := by
      rw [← MorphismProperty.Over.w a, ← Category.assoc, show l ≫ a.left = i.left from h.lift_fst _ _ _]
      exact MorphismProperty.Over.w i
    exact ⟨MorphismProperty.Over.homMk l hw, MorphismProperty.Over.Hom.ext (h.lift_fst _ _ _),
      MorphismProperty.Over.Hom.ext (h.lift_snd _ _ _)⟩

variable (I : Sheaf (X (A := A)).smallEtaleTopology AddCommGrpCat.{u + 1})
  {B D O M N : Under (R (A := A))}
  [Etale (Spec.map B.hom)] [Etale (Spec.map D.hom)] [Etale (Spec.map O.hom)]
  [Etale (Spec.map M.hom)] [Etale (Spec.map N.hom)]

private theorem restrict_restrict {U V W : (X (A := A)).Etale} (f : U ⟶ V) (g : V ⟶ W)
    (x : I.obj.obj (op W)) :
    I.obj.map f.op (I.obj.map g.op x) = I.obj.map (f ≫ g).op x := by
  rw [op_comp, Functor.map_comp, ConcreteCategory.comp_apply]

set_option maxHeartbeats 3600000 in
/-- The section generated by the finite matching diagram genuinely
glues in the originally specified small étale sheaf. -/
theorem exists_glue (f : B ⟶ D) (p q : D ⟶ O) (a b : M ⟶ N)
    (v : M ⟶ D) (w : N ⟶ O) (h₁ : a ≫ w = v ≫ p) (h₂ : b ≫ w = v ≫ q)
    (hPB : IsPullback (Spec.map p.right) (Spec.map q.right) (Spec.map f.right) (Spec.map f.right))
    (hCov : Function.Surjective (Spec.map f.right)) (x : I.obj.obj (op (obj M)))
    (hMatch : I.obj.map (arrow a).op x = I.obj.map (arrow b).op x) :
    ∃ s : I.obj.obj (op (obj B)), I.obj.map (arrow f).op s = I.obj.map (arrow v).op x := by
  let y := I.obj.map (arrow v).op x
  have he : I.obj.map (arrow p).op y = I.obj.map (arrow q).op y := by
    change I.obj.map (arrow p).op (I.obj.map (arrow v).op x) =
      I.obj.map (arrow q).op (I.obj.map (arrow v).op x)
    rw [restrict_restrict, restrict_restrict, arrow_comp, arrow_comp, ← h₁, ← h₂,
      ← arrow_comp, ← arrow_comp, ← restrict_restrict, ← restrict_restrict, hMatch]
  have h : IsPullback (arrow p) (arrow q) (arrow f) (arrow f) := under_isPullback hPB
  obtain ⟨s, hs, _⟩ := NativeEtaleSingletonSectionGluing.existsUnique_glue I (arrow f)
    (arrow p) (arrow q) h hCov y he
  exact ⟨s, hs⟩

end
end ManuscriptAudit.NativeEtaleUnderRingGluing

open Lean Elab Command in
run_cmd do
  let name := ``ManuscriptAudit.NativeEtaleUnderRingGluing.exists_glue
  let dependencies ← collectAxioms name
  let allowed : List Name := [``propext, ``Classical.choice, ``Quot.sound]
  let unexpected := dependencies.filter fun axiomName => !allowed.contains axiomName
  unless unexpected.isEmpty do
    throwError m!"{name} depends on unexpected axioms {unexpected}"
  logInfo m!"{name} uses {dependencies}"

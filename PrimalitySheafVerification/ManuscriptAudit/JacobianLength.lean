import Lean.Util.CollectAxioms
import Mathlib.Algebra.Field.ZMod
import Mathlib.Algebra.MvPolynomial.PDeriv
import Mathlib.Algebra.Polynomial.Degree.Operations
import Mathlib.Data.ZMod.Basic
import Mathlib.RingTheory.Finiteness.Cardinality
import Mathlib.RingTheory.HopkinsLevitzki
import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.RingTheory.Length
import Mathlib.RingTheory.Localization.AtPrime.Basic
import Mathlib.RingTheory.Localization.FractionRing

/-!
Paper 2, physical p. 44, §5.5(C), gives the finite local Jacobian length
pₙA for the branch where the characteristic divides both exponents.
At p=pₙ=A=2 the Jacobian ideal vanishes and the local quotient contains
infinitely many distinct powers of the first coordinate. The p. 45 script
returns infinity for this branch.
-/

namespace ManuscriptAudit.JacobianLength

noncomputable section

set_option maxHeartbeats 1000000

private instance : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
private abbrev K := ZMod 2
private abbrev R := MvPolynomial (Fin 2) K
private abbrev P := Polynomial K
private abbrev F := FractionRing P

/-- The actual reduced equation with pₙ=A=2. -/
def equation : R := MvPolynomial.X 0 ^ 2 + MvPolynomial.X 1 ^ 2

private abbrev I : Ideal R := Ideal.span {equation}

/-- The coordinate ring of the given fiber. -/
abbrev CurveRing := R ⧸ I

private def lineSubstitution : R →+* P :=
  (MvPolynomial.aeval (fun _ : Fin 2 => (Polynomial.X : P))).toRingHom

private theorem lineSubstitution_equation : lineSubstitution equation = 0 := by
  have htwo : (2 : P) = 0 := by
    have hk : (2 : K) = 0 := by decide
    rw [← map_ofNat (Polynomial.C : K →+* P) 2, hk, map_zero]
  change MvPolynomial.aeval (fun _ : Fin 2 => (Polynomial.X : P)) equation = 0
  simp only [equation, map_add, map_pow, MvPolynomial.aeval_X]
  rw [← two_mul, htwo, zero_mul]

private def lineMap : CurveRing →+* P :=
  Ideal.Quotient.lift I lineSubstitution (by
    intro g hg
    obtain ⟨h, rfl⟩ := Ideal.mem_span_singleton.mp hg
    rw [map_mul, lineSubstitution_equation, zero_mul])

/-- Evaluation at the origin, realized by restricting to x=y and setting x=0. -/
def originResidue : CurveRing →+* K :=
  (Polynomial.evalRingHom 0).comp lineMap

private abbrev originIdeal : Ideal CurveRing := RingHom.ker originResidue

private instance : originIdeal.IsPrime := RingHom.ker_isPrime originResidue

/-- The stalk at the origin of the fiber. -/
abbrev OriginLocalRing := Localization.AtPrime originIdeal

/-- The ideal in the local ring generated by the two partial derivatives. -/
def localJacobianIdeal : Ideal OriginLocalRing :=
  Ideal.span (Set.range fun i : Fin 2 =>
    algebraMap CurveRing OriginLocalRing
      (Ideal.Quotient.mk I (MvPolynomial.pderiv i equation)))

/-- Both partials vanish in characteristic two. -/
theorem paper2_localJacobianIdeal_eq_bot : localJacobianIdeal = ⊥ := by
  have htwo : ((2 : ℕ) : R) = 0 := by
    simpa only [map_natCast, map_zero] using
      congrArg (fun c : K => (MvPolynomial.C c : R)) (ZMod.natCast_self 2)
  unfold localJacobianIdeal
  apply Ideal.span_eq_bot.mpr
  rintro _ ⟨i, rfl⟩
  simp only [equation, map_add, MvPolynomial.pderiv_pow, htwo, zero_mul, add_zero, map_zero]

/-- The residue-field submodule underlying the localized Jacobian ideal. -/
def localJacobianSubmodule : Submodule K OriginLocalRing where
  carrier := (localJacobianIdeal : Set OriginLocalRing)
  zero_mem' := localJacobianIdeal.zero_mem
  add_mem' := localJacobianIdeal.add_mem
  smul_mem' c z hz := by
    change z ∈ localJacobianIdeal at hz
    rw [paper2_localJacobianIdeal_eq_bot] at hz
    have hzero : z = 0 := Ideal.mem_bot.mp hz
    change c • z ∈ localJacobianIdeal
    rw [hzero, smul_zero]
    exact localJacobianIdeal.zero_mem

/-- The coefficient-field submodule and the local ideal have the same elements. -/
theorem paper2_localJacobianSubmodule_mem_iff (z : OriginLocalRing) :
    z ∈ localJacobianSubmodule ↔ z ∈ localJacobianIdeal := Iff.rfl

private theorem localJacobianSubmodule_eq_bot : localJacobianSubmodule = ⊥ := by
  ext z
  rw [paper2_localJacobianSubmodule_mem_iff, paper2_localJacobianIdeal_eq_bot,
    Ideal.mem_bot, Submodule.mem_bot]

/-- The precise localized Jacobian quotient as a residue-field module. -/
abbrev OriginJacobianQuotient : Type := OriginLocalRing ⧸ localJacobianSubmodule

private def lineToFraction : CurveRing →+* F :=
  (algebraMap P F).comp lineMap

private theorem lineToFraction_unit (u : originIdeal.primeCompl) :
    IsUnit (lineToFraction u) := by
  apply isUnit_iff_ne_zero.mpr
  intro hu
  apply (show (u : CurveRing) ∉ originIdeal from u.property)
  have hp : lineMap u = 0 := by
    apply IsFractionRing.injective P F
    simpa only [lineToFraction, RingHom.comp_apply, map_zero] using hu
  change Polynomial.evalRingHom 0 (lineMap u) = 0
  rw [hp, map_zero]

private def localLine : OriginLocalRing →+* F :=
  IsLocalization.lift (M := originIdeal.primeCompl) lineToFraction_unit

private theorem localLine_map (u : CurveRing) :
    localLine (algebraMap CurveRing OriginLocalRing u) = lineToFraction u :=
  IsLocalization.lift_eq lineToFraction_unit u

private def firstCoordinate : OriginLocalRing :=
  algebraMap CurveRing OriginLocalRing (Ideal.Quotient.mk I (MvPolynomial.X 0))

private theorem localLine_firstCoordinate :
    localLine firstCoordinate = algebraMap P F (Polynomial.X : P) := by
  rw [firstCoordinate, localLine_map]
  change algebraMap P F
    (MvPolynomial.aeval (fun _ : Fin 2 => (Polynomial.X : P)) (MvPolynomial.X 0)) = _
  rw [MvPolynomial.aeval_X]

private theorem powers_firstCoordinate_injective :
    Function.Injective (fun n : ℕ => firstCoordinate ^ n) := by
  intro n m h
  have hF := congrArg localLine h
  simp only [map_pow, localLine_firstCoordinate] at hF
  have hP : (Polynomial.X : P) ^ n = (Polynomial.X : P) ^ m := by
    apply IsFractionRing.injective P F
    simpa only [map_pow] using hF
  simpa only [Polynomial.natDegree_X_pow] using congrArg Polynomial.natDegree hP

private theorem originLocalRing_not_finite : ¬ Module.Finite K OriginLocalRing := by
  intro h
  letI : Module.Finite K OriginLocalRing := h
  letI : Infinite OriginLocalRing := Infinite.of_injective _ powers_firstCoordinate_injective
  letI : Finite OriginLocalRing := Module.finite_of_finite K
  exact not_finite OriginLocalRing

/-- The actual local Jacobian quotient has infinite dimension over the residue field. -/
theorem paper2_localJacobianQuotient_not_finite :
    ¬ Module.Finite K OriginJacobianQuotient := by
  intro h
  let e := localJacobianSubmodule.quotEquivOfEqBot localJacobianSubmodule_eq_bot
  exact originLocalRing_not_finite ((Module.Finite.equiv_iff e).mp h)

/-- The local Jacobian quotient has infinite module length. -/
theorem paper2_localJacobianQuotient_length_eq_top :
    Module.length K OriginJacobianQuotient = ⊤ := by
  classical
  by_contra htop
  have hfl : IsFiniteLength K OriginJacobianQuotient := Module.length_ne_top_iff.mp htop
  exact paper2_localJacobianQuotient_not_finite
    (((IsArtinianRing.tfae (R := K) (M := OriginJacobianQuotient)).out 3 0).mp hfl)

/-- The finite value pₙA=4 printed in the table fails at this fiber. -/
theorem paper2_localJacobianQuotient_not_length_four :
    Module.length K OriginJacobianQuotient ≠ 4 := by
  rw [paper2_localJacobianQuotient_length_eq_top]
  exact ENat.top_ne_ofNat 4

end

open Lean Elab Command in
run_cmd do
  let allowed : List Name := [``propext, ``Classical.choice, ``Quot.sound]
  for name in [``paper2_localJacobianIdeal_eq_bot, ``paper2_localJacobianSubmodule_mem_iff,
      ``paper2_localJacobianQuotient_not_finite,
      ``paper2_localJacobianQuotient_length_eq_top, ``paper2_localJacobianQuotient_not_length_four] do
    let dependencies ← collectAxioms name
    let unexpected := dependencies.filter fun axiomName => !allowed.contains axiomName
    unless unexpected.isEmpty do
      throwError m!"{name} depends on unexpected axioms {unexpected}"
    logInfo m!"{name} uses {dependencies}"

end ManuscriptAudit.JacobianLength

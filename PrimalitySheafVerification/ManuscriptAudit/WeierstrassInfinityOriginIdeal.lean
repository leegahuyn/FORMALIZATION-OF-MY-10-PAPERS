import Lean.Util.CollectAxioms
import Mathlib.Algebra.Polynomial.Eval.Coeff
import Mathlib.Algebra.Polynomial.RingDivision
import PrimalitySheafVerification.ManuscriptAudit.WeierstrassInfinityChartAlgebra

/-! The origin has its actual scheme-theoretic ideal generated by the two coordinates,
and the localized rational origin has precisely the principal parameter ideal. -/

namespace ManuscriptAudit.WeierstrassInfinityOriginIdeal

open Polynomial WeierstrassInfinityChartAlgebra
open scoped Polynomial.Bivariate

universe u

noncomputable section

variable {K : Type u} [Field K] (W : WeierstrassCurve.Affine K)

theorem origin_mk (p : K[X][Y]) :
    origin W (AdjoinRoot.mk (equation W) p) = (p.coeff 0).eval 0 := by
  unfold origin
  rw [AdjoinRoot.liftAlgHom_mk, Polynomial.eval₂_at_zero]
  rfl

/-- The scheme-theoretic origin is cut out by the two literal coordinates. -/
theorem origin_ker : RingHom.ker (origin W).toRingHom = Ideal.span ({x W, z W} : Set (Ring W)) := by
  apply le_antisymm
  · intro a ha
    obtain ⟨p, rfl⟩ := AdjoinRoot.mk_surjective (g := equation W) a
    change origin W (AdjoinRoot.mk (equation W) p) = 0 at ha
    rw [origin_mk, ← Polynomial.coeff_zero_eq_eval_zero] at ha
    let m := AdjoinRoot.mk (equation W)
    let I : Ideal (Ring W) := Ideal.span {x W, z W}
    have hX : (X : K[X]) ∣ p.coeff 0 := Polynomial.X_dvd_iff.mpr ha
    have hCX : (C (X : K[X]) : K[X][Y]) ∣ C (p.coeff 0) :=
      map_dvd (Polynomial.C : K[X] →+* K[X][Y]) hX
    have hY : (Y : K[X][Y]) ∣ p - C (p.coeff 0) := by
      apply Polynomial.X_dvd_iff.mpr
      rw [Polynomial.coeff_sub, Polynomial.coeff_C_zero, sub_self]
    have hC : m (C (p.coeff 0)) ∈ I := by
      obtain ⟨q, hq⟩ := hCX
      rw [hq, map_mul]
      exact I.mul_mem_right _ (Ideal.subset_span (by simp [I, x, m]))
    have hSub : m p - m (C (p.coeff 0)) ∈ I := by
      obtain ⟨q, hq⟩ := hY
      rw [← map_sub, hq, map_mul]
      exact I.mul_mem_right _ (Ideal.subset_span (by simp [I, z, m]))
    simpa only [sub_add_cancel] using I.add_mem hSub hC
  · apply Ideal.span_le.mpr
    rw [Set.insert_subset_iff, Set.singleton_subset_iff]
    exact ⟨origin_x W, origin_z W⟩

/-- The rational origin lies in the neighborhood where the bracket is invertible. -/
def localOrigin : Neighborhood W →ₐ[K] K :=
  IsLocalization.Away.liftAlgHom (bracket W) (f := origin W)
    (by rw [origin_bracket]; exact isUnit_one)

theorem localOrigin_map (a : Ring W) :
    localOrigin W (algebraMap (Ring W) (Neighborhood W) a) = origin W a := by
  unfold localOrigin
  rw [IsLocalization.Away.liftAlgHom_apply, IsLocalization.Away.lift_eq] <;> rfl

theorem localOrigin_x : localOrigin W (localX W) = 0 := by
  rw [localX, localOrigin_map, origin_x]

/-- The fiber over the origin on this neighborhood is the principal ideal (u). -/
theorem localOrigin_ker :
    RingHom.ker (localOrigin W).toRingHom =
      Ideal.span ({localX W} : Set (Neighborhood W)) := by
  let I : Ideal (Neighborhood W) := Ideal.span {localX W}
  apply le_antisymm
  · intro a ha
    change localOrigin W a = 0 at ha
    obtain ⟨n, b, hb⟩ := IsLocalization.Away.surj (x := bracket W) a
    have hb₀ : origin W b = 0 := by
      have h := congrArg (localOrigin W) hb
      rw [map_mul, ha, zero_mul, localOrigin_map] at h
      exact h.symm
    have hbI : b ∈ Ideal.span ({x W, z W} : Set (Ring W)) := by
      rw [← origin_ker]
      exact hb₀
    have hMap : Ideal.map (algebraMap (Ring W) (Neighborhood W))
        (Ideal.span ({x W, z W} : Set (Ring W))) ≤ I := by
      apply Ideal.map_le_iff_le_comap.mpr
      apply Ideal.span_le.mpr
      rw [Set.insert_subset_iff, Set.singleton_subset_iff]
      change localX W ∈ I ∧ localZ W ∈ I
      constructor
      · exact Ideal.subset_span (Set.mem_singleton _)
      · change localZ W ∈ Ideal.span ({localX W} : Set (Neighborhood W))
        rw [← local_originIdeal_principal]
        exact Ideal.subset_span (by simp)
    have hI : algebraMap (Ring W) (Neighborhood W) b ∈ I :=
      hMap (Ideal.mem_map_of_mem _ hbI)
    have hu := IsLocalization.Away.algebraMap_pow_isUnit (S := Neighborhood W) (bracket W) n
    obtain ⟨y, hy⟩ := hu
    have hprod : a * (y : Neighborhood W) ∈ I := by rw [hy, hb]; exact hI
    have h := I.mul_mem_right (↑(y⁻¹) : Neighborhood W) hprod
    simpa only [mul_assoc, Units.mul_inv, mul_one] using h
  · apply Ideal.span_le.mpr
    rw [Set.singleton_subset_iff]
    exact localOrigin_x W

end

end ManuscriptAudit.WeierstrassInfinityOriginIdeal

open Lean Elab Command in
run_cmd do
  let allowed : List Name := [``propext, ``Classical.choice, ``Quot.sound]
  for name in [``ManuscriptAudit.WeierstrassInfinityOriginIdeal.origin_mk,
      ``ManuscriptAudit.WeierstrassInfinityOriginIdeal.origin_ker,
      ``ManuscriptAudit.WeierstrassInfinityOriginIdeal.localOrigin_map,
      ``ManuscriptAudit.WeierstrassInfinityOriginIdeal.localOrigin_ker] do
    let ax ← collectAxioms name
    let bad := ax.filter fun n => !allowed.contains n
    unless bad.isEmpty do
      throwError m!"{name} depends on unexpected axioms {bad}"
    logInfo m!"{name} uses {ax}"

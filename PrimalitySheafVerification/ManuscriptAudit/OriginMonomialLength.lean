import Lean.Util.CollectAxioms
import Mathlib.Algebra.MvPolynomial.PDeriv
import Mathlib.Data.Finsupp.Order
import Mathlib.LinearAlgebra.Dimension.Constructions
import Mathlib.LinearAlgebra.Isomorphisms
import Mathlib.RingTheory.Length
import Mathlib.RingTheory.Localization.AtPrime.Basic
import Mathlib.RingTheory.Localization.Ideal
import Mathlib.RingTheory.MvPolynomial.Ideal
import Mathlib.RingTheory.Nilpotent.Basic
import Mathlib.Tactic.FinCases

/-!
# Monomial normal form in the origin-local plane

For positive exponents, the quotient by the two coordinate powers is already
unchanged by localization at the origin. Its actual vector-space coordinates
are the coefficients in the rectangle below the two defining powers.
-/

namespace ManuscriptAudit.OriginMonomialLength

open MvPolynomial

noncomputable section

variable (K : Type) [Field K]

private abbrev R := MvPolynomial (Fin 2) K

/-- The ideal of the origin in the affine plane over the coefficient field. -/
abbrev originIdeal : Ideal (R K) := RingHom.ker (constantCoeff : R K →+* K)

instance : (originIdeal K).IsPrime := RingHom.ker_isPrime _

/-- The actual local ring at the origin of the affine plane. -/
abbrev OriginRing := Localization.AtPrime (originIdeal K)

/-- The ideal generated by the two coordinate powers. -/
def boxIdeal (m n : ℕ) : Ideal (R K) :=
  Ideal.span {X 0 ^ m, X 1 ^ n}

private theorem mem_boxIdeal (m n : ℕ) (f : R K) :
    f ∈ boxIdeal K m n ↔ ∀ d ∈ f.support, m ≤ d 0 ∨ n ≤ d 1 := by
  classical
  have hs : (fun d => monomial d (1 : K)) ''
      {Finsupp.single (0 : Fin 2) m, Finsupp.single 1 n} =
        {X 0 ^ m, X 1 ^ n} := by rw [Set.image_pair, X_pow_eq_monomial, X_pow_eq_monomial]
  rw [boxIdeal, ← hs, mem_ideal_span_monomial_image]
  constructor
  · intro h d hd
    obtain ⟨e, he, hed⟩ := h d hd
    rcases Set.mem_insert_iff.mp he with rfl | h'
    · exact Or.inl (Finsupp.single_le_iff.mp hed)
    · rw [Set.mem_singleton_iff.mp h'] at hed
      exact Or.inr (Finsupp.single_le_iff.mp hed)
  · intro h d hd
    rcases h d hd with hm | hn
    · exact ⟨_, by simp, Finsupp.single_le_iff.mpr hm⟩
    · exact ⟨_, by simp, Finsupp.single_le_iff.mpr hn⟩

private def boxExponent {m n : ℕ} (i : Fin m × Fin n) : Fin 2 →₀ ℕ :=
  Finsupp.single 0 i.1.val + Finsupp.single 1 i.2.val

@[simp] private theorem boxExponent_zero {m n : ℕ} (i : Fin m × Fin n) :
    boxExponent i 0 = i.1.val := by simp [boxExponent]

@[simp] private theorem boxExponent_one {m n : ℕ} (i : Fin m × Fin n) :
    boxExponent i 1 = i.2.val := by simp [boxExponent]

private theorem boxExponent_injective (m n : ℕ) :
    Function.Injective (@boxExponent m n) := by
  intro i j h
  apply Prod.ext
  · exact Fin.ext (by simpa only [boxExponent_zero] using congrArg (fun d : Fin 2 →₀ ℕ => d 0) h)
  · exact Fin.ext (by simpa only [boxExponent_one] using congrArg (fun d : Fin 2 →₀ ℕ => d 1) h)

private def boxLinear (m n : ℕ) : R K →ₗ[K] ((Fin m × Fin n) → K) :=
  LinearMap.pi fun i => lcoeff (boxExponent i)

@[simp] private theorem boxLinear_apply (m n : ℕ) (f : R K) (i : Fin m × Fin n) :
    boxLinear K m n f i = coeff (boxExponent i) f := rfl

private theorem boxLinear_surjective (m n : ℕ) :
    Function.Surjective (boxLinear K m n) := by
  classical
  intro a
  refine ⟨∑ i, monomial (boxExponent i) (a i), ?_⟩
  funext i
  rw [boxLinear_apply, coeff_sum, Finset.sum_eq_single i]
  · simp [coeff_monomial]
  · intro j _ hji
    simp only [coeff_monomial, if_neg (fun h => hji (boxExponent_injective m n h))]
  · simp

private theorem boxLinear_ker (m n : ℕ) :
    LinearMap.ker (boxLinear K m n) = (boxIdeal K m n).restrictScalars K := by
  classical
  ext f
  rw [LinearMap.mem_ker, Submodule.restrictScalars_mem, mem_boxIdeal]
  constructor
  · intro hf d hd
    by_contra hn
    have hdm : d 0 < m := Nat.lt_of_not_ge (fun h => hn (Or.inl h))
    have hdn : d 1 < n := Nat.lt_of_not_ge (fun h => hn (Or.inr h))
    let i : Fin m × Fin n := (⟨d 0, hdm⟩, ⟨d 1, hdn⟩)
    have hi : boxExponent i = d := by
      ext j
      fin_cases j
      · exact boxExponent_zero i
      · exact boxExponent_one i
    have hz : coeff d f = 0 := by
      simpa only [boxLinear_apply, hi, Pi.zero_apply] using congrFun hf i
    exact (mem_support_iff.mp hd) hz
  · intro hf
    funext i
    rw [boxLinear_apply, Pi.zero_apply]
    by_contra h
    obtain hm | hn := hf (boxExponent i) (mem_support_iff.mpr h)
    · exact (Nat.not_le_of_lt i.1.isLt) (by simpa using hm)
    · exact (Nat.not_le_of_lt i.2.isLt) (by simpa using hn)

/-- Coefficients give the normal form of the actual polynomial quotient. -/
def boxQuotientLinearEquiv (m n : ℕ) :
    (R K ⧸ boxIdeal K m n) ≃ₗ[K] ((Fin m × Fin n) → K) :=
  ((Submodule.Quotient.restrictScalarsEquiv K (boxIdeal K m n)).symm.trans
    (Submodule.quotEquivOfEq _ _ (boxLinear_ker K m n).symm)).trans
    (LinearMap.quotKerEquivOfSurjective _ (boxLinear_surjective K m n))

private theorem originIdeal_le_radical_box (m n : ℕ) :
    originIdeal K ≤ (boxIdeal K m n).radical := by
  classical
  have heq : (Set.range (X : Fin 2 → R K)) = X '' (Set.univ : Set (Fin 2)) := by simp
  have hspan : originIdeal K ≤ Ideal.span (Set.range (X : Fin 2 → R K)) := by
    intro f hf
    rw [heq, mem_ideal_span_X_image]
    intro d hd
    have hd0 : d ≠ 0 := by
      intro he
      apply mem_support_iff.mp hd
      rw [he]
      exact hf
    have h : ∃ i, d i ≠ 0 := by
      by_contra hn
      push_neg at hn
      apply hd0
      ext i
      simpa using hn i
    obtain ⟨i, hi⟩ := h
    exact ⟨i, Set.mem_univ _, hi⟩
  apply hspan.trans
  refine Ideal.span_le.mpr ?_
  rintro _ ⟨i, rfl⟩
  fin_cases i
  · exact ⟨m, Ideal.subset_span (by simp [boxIdeal])⟩
  · exact ⟨n, Ideal.subset_span (by simp [boxIdeal])⟩

private theorem box_denominator_isUnit (m n : ℕ) (s : (originIdeal K).primeCompl) :
    IsUnit (Ideal.Quotient.mk (boxIdeal K m n) (s : R K)) := by
  let q := Ideal.Quotient.mk (boxIdeal K m n)
  let c := constantCoeff (s : R K)
  have hc : c ≠ 0 := s.property
  have hd : (s : R K) - C c ∈ originIdeal K := by
    change constantCoeff ((s : R K) - C c) = 0
    rw [map_sub, constantCoeff_C, sub_self]
  obtain ⟨e, he⟩ := Ideal.mem_radical_iff.mp (originIdeal_le_radical_box K m n hd)
  have hnil : IsNilpotent (q ((s : R K) - C c)) :=
    ⟨e, by rw [← map_pow]; exact Ideal.Quotient.eq_zero_iff_mem.mpr he⟩
  have hunit : IsUnit (q (C c)) := ((isUnit_iff_ne_zero.mpr hc).map (C : K →+* R K)).map q
  have h := hnil.isUnit_add_left_of_commute hunit (Commute.all _ _)
  have hsum : C c + ((s : R K) - C c) = (s : R K) := by
    rw [add_comm, sub_add_cancel]
  simpa only [← map_add, hsum] using h

/-- Localizing the polynomial quotient at the origin changes none of its elements. -/
def boxLocalEquiv (m n : ℕ) :
    (R K ⧸ boxIdeal K m n) ≃ₐ[K]
      (OriginRing K ⧸ (boxIdeal K m n).map (algebraMap (R K) (OriginRing K))) := by
  let Q := R K ⧸ boxIdeal K m n
  let L := OriginRing K ⧸ (boxIdeal K m n).map (algebraMap (R K) (OriginRing K))
  let S := Algebra.algebraMapSubmonoid Q (originIdeal K).primeCompl
  have hS : S ≤ IsUnit.submonoid Q := by
    rintro _ ⟨s, hs, rfl⟩
    exact box_denominator_isUnit K m n ⟨s, hs⟩
  letI : IsLocalization S L := inferInstance
  exact (IsLocalization.atUnits Q S hS (S := L)).restrictScalars K

/-- The true origin-local quotient by coordinate powers has the rectangle's length. -/
theorem boxLocalLength (m n : ℕ) :
    Module.length K (OriginRing K ⧸
      (boxIdeal K m n).map (algebraMap (R K) (OriginRing K))) = ((m * n : ℕ) : ℕ∞) := by
  rw [← (boxLocalEquiv K m n).toLinearEquiv.length_eq,
    (boxQuotientLinearEquiv K m n).length_eq, Module.length_eq_finrank,
    Module.finrank_fintype_fun_eq_card, Fintype.card_prod, Fintype.card_fin, Fintype.card_fin]

/-- The paper's bivariate benchmark polynomial. -/
def benchmark (a b : ℕ) : R K := X 0 ^ a + X 1 ^ b

/-- The actual Tjurina ideal, generated by the equation and both partials. -/
def benchmarkJacobian (a b : ℕ) : Ideal (R K) :=
  Ideal.span {benchmark K a b, pderiv 0 (benchmark K a b), pderiv 1 (benchmark K a b)}

private theorem pderiv_zero_benchmark (a b : ℕ) :
    pderiv 0 (benchmark K a b) = C (a : K) * X 0 ^ (a - 1) := by
  have h : pderiv (0 : Fin 2) (X 1 : R K) = 0 := by
    rw [pderiv_X]
    simp
  simp only [benchmark, map_add, pderiv_pow, pderiv_X_self, h, mul_one,
    mul_zero, add_zero, map_natCast]

private theorem pderiv_one_benchmark (a b : ℕ) :
    pderiv 1 (benchmark K a b) = C (b : K) * X 1 ^ (b - 1) := by
  have h : pderiv (1 : Fin 2) (X 0 : R K) = 0 := by
    rw [pderiv_X]
    simp
  simp only [benchmark, map_add, pderiv_pow, pderiv_X_self, h, mul_one,
    mul_zero, zero_add, map_natCast]

private theorem pow_mem_ideal_of_le (I : Ideal (R K)) (x : R K) {r s : ℕ} (h : r ≤ s)
    (hr : x ^ r ∈ I) : x ^ s ∈ I := by
  rw [← Nat.sub_add_cancel h, pow_add]
  exact I.mul_mem_left _ hr

private theorem mem_ideal_of_nonzero_coefficient (I : Ideal (R K)) (c : K)
    (hc : c ≠ 0) (x : R K) (hx : C c * x ∈ I) : x ∈ I := by
  have h := I.mul_mem_left (C c⁻¹) hx
  rwa [← mul_assoc, ← map_mul, inv_mul_cancel₀ hc, map_one, one_mul] at h

/-- Whenever at least one partial has nonzero scalar coefficient, the actual
Jacobian ideal is generated by the indicated coordinate powers. -/
theorem benchmarkJacobian_eq_box (a b : ℕ) (h : (a : K) ≠ 0 ∨ (b : K) ≠ 0) :
    benchmarkJacobian K a b =
      boxIdeal K (if (a : K) = 0 then a else a - 1) (if (b : K) = 0 then b else b - 1) := by
  classical
  let I := benchmarkJacobian K a b
  let m := if (a : K) = 0 then a else a - 1
  let n := if (b : K) = 0 then b else b - 1
  let J := boxIdeal K m n
  have hf : benchmark K a b ∈ I := Ideal.subset_span (by simp)
  have hdx : C (a : K) * X 0 ^ (a - 1) ∈ I := by
    rw [← pderiv_zero_benchmark]
    exact Ideal.subset_span (by simp)
  have hdy : C (b : K) * X 1 ^ (b - 1) ∈ I := by
    rw [← pderiv_one_benchmark]
    exact Ideal.subset_span (by simp)
  have hx : (a : K) ≠ 0 → X 0 ^ (a - 1) ∈ I :=
    fun ha => mem_ideal_of_nonzero_coefficient K I (a : K) ha _ hdx
  have hy : (b : K) ≠ 0 → X 1 ^ (b - 1) ∈ I :=
    fun hb => mem_ideal_of_nonzero_coefficient K I (b : K) hb _ hdy
  have hm : m ≤ a := by by_cases ha : (a : K) = 0 <;> simp [m, ha]
  have hn : n ≤ b := by by_cases hb : (b : K) = 0 <;> simp [n, hb]
  have hJx : X 0 ^ m ∈ J := Ideal.subset_span (by simp)
  have hJy : X 1 ^ n ∈ J := Ideal.subset_span (by simp)
  change I = J
  apply le_antisymm
  · refine Ideal.span_le.mpr ?_
    intro z hz
    rcases Set.mem_insert_iff.mp hz with rfl | hz
    · exact J.add_mem (pow_mem_ideal_of_le K J _ hm hJx) (pow_mem_ideal_of_le K J _ hn hJy)
    rcases Set.mem_insert_iff.mp hz with rfl | hz
    · rw [pderiv_zero_benchmark]
      by_cases ha : (a : K) = 0
      · simpa only [ha, map_zero, zero_mul] using J.zero_mem
      · exact J.mul_mem_left _ (by simpa only [m, if_neg ha] using hJx)
    rw [Set.mem_singleton_iff.mp hz, pderiv_one_benchmark]
    by_cases hb : (b : K) = 0
    · simpa only [hb, map_zero, zero_mul] using J.zero_mem
    · exact J.mul_mem_left _ (by simpa only [n, if_neg hb] using hJy)
  · refine Ideal.span_le.mpr ?_
    intro z hz
    rcases Set.mem_insert_iff.mp hz with rfl | hz
    · by_cases ha : (a : K) = 0
      · have hb := h.resolve_left (not_ne_iff.mpr ha)
        have hY := pow_mem_ideal_of_le K I _ (Nat.sub_le b 1) (hy hb)
        have hX := I.sub_mem hf hY
        simpa only [benchmark, add_sub_cancel_right, m, if_pos ha] using hX
      · simpa only [m, if_neg ha] using hx ha
    rw [Set.mem_singleton_iff.mp hz]
    by_cases hb : (b : K) = 0
    · have ha := h.resolve_right (not_ne_iff.mpr hb)
      have hX := pow_mem_ideal_of_le K I _ (Nat.sub_le a 1) (hx ha)
      have hY := I.sub_mem hf hX
      simpa only [benchmark, add_sub_cancel_left, n, if_pos hb] using hY
    · simpa only [n, if_neg hb] using hy hb

/-- The three finite benchmark rows are actual localization lengths. -/
theorem benchmarkLocalLength (a b : ℕ) (h : (a : K) ≠ 0 ∨ (b : K) ≠ 0) :
    Module.length K (OriginRing K ⧸
      (benchmarkJacobian K a b).map (algebraMap (R K) (OriginRing K))) =
      (((if (a : K) = 0 then a else a - 1) * (if (b : K) = 0 then b else b - 1) : ℕ) : ℕ∞) := by
  rw [benchmarkJacobian_eq_box K a b h, boxLocalLength]

end

end ManuscriptAudit.OriginMonomialLength

open Lean Elab Command in
run_cmd do
  let allowed : List Name := [``propext, ``Classical.choice, ``Quot.sound]
  for name in [``ManuscriptAudit.OriginMonomialLength.boxQuotientLinearEquiv,
      ``ManuscriptAudit.OriginMonomialLength.boxLocalEquiv,
      ``ManuscriptAudit.OriginMonomialLength.boxLocalLength,
      ``ManuscriptAudit.OriginMonomialLength.benchmarkJacobian_eq_box,
      ``ManuscriptAudit.OriginMonomialLength.benchmarkLocalLength] do
    let dependencies ← collectAxioms name
    let unexpected := dependencies.filter fun axiomName => !allowed.contains axiomName
    unless unexpected.isEmpty do
      throwError m!"{name} depends on unexpected axioms {unexpected}"
    logInfo m!"{name} uses {dependencies}"

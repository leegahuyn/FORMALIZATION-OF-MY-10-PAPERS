import Lean.Util.CollectAxioms
import Mathlib.RingTheory.DedekindDomain.Ideal.Basic

/-! The subalgebra generated by the inverse of a nonzero Dedekind ideal
turns that ideal into the unit ideal in the actual fraction field. -/

namespace ManuscriptAudit.DedekindInverseIdealAlgebra

open scoped nonZeroDivisors Pointwise

noncomputable section

universe u

variable (A K : Type u) [CommRing A] [IsDedekindDomain A] [Field K]
  [Algebra A K] [IsFractionRing A K]

abbrev inverseIdeal (I : Ideal A) : FractionalIdeal A⁰ K := (I : FractionalIdeal A⁰ K)⁻¹

abbrev outsideAlgebra (I : Ideal A) : Subalgebra A K :=
  Algebra.adjoin A (inverseIdeal A K I : Set K)

/-- Every inverse-ideal generator has an ordinary fraction
presentation with any given nonzero element of the ideal as denominator. -/
theorem exists_numerator (I : Ideal A) (hI : I ≠ ⊥) {a : A} (ha : a ∈ I)
    {x : K} (hx : x ∈ inverseIdeal A K I) :
    ∃ b : A, algebraMap A K b = x * algebraMap A K a := by
  have hI₀ : (I : FractionalIdeal A⁰ K) ≠ 0 :=
    (FractionalIdeal.coeIdeal_ne_zero' (le_refl A⁰)).mpr hI
  exact (FractionalIdeal.mem_one_iff A⁰).mp
    ((FractionalIdeal.mem_inv_iff hI₀).mp hx _ (FractionalIdeal.mem_coeIdeal_of_mem A⁰ ha))

set_option maxHeartbeats 1600000 in
/-- In the genuine subalgebra of the fraction field generated by the
inverse ideal, the original ideal generates the unit ideal. -/
theorem map_eq_top (I : Ideal A) (hI : I ≠ ⊥) :
    I.map (algebraMap A (outsideAlgebra A K I)) = ⊤ := by
  let G := outsideAlgebra A K I
  let J := I.map (algebraMap A G)
  let L : Submodule A K := (J.restrictScalars A).map G.val.toLinearMap
  have hOne : (1 : K) ∈ (I : FractionalIdeal A⁰ K) * inverseIdeal A K I := by
    rw [show (I : FractionalIdeal A⁰ K) * inverseIdeal A K I = 1 from
      FractionalIdeal.coe_ideal_mul_inv I hI]
    exact (FractionalIdeal.mem_one_iff A⁰).mpr ⟨1, map_one _⟩
  obtain ⟨T, T', hT, hT', hSpan⟩ := FractionalIdeal.mem_span_mul_finite_of_mem_mul hOne
  have hLe : Submodule.span A ((T : Set K) * (T' : Set K)) ≤ L := by
    apply Submodule.span_le.mpr
    intro z hz
    obtain ⟨x, hx, y, hy, hxy⟩ := Set.mem_mul.mp hz
    obtain ⟨a, ha, hxa⟩ := (FractionalIdeal.mem_coeIdeal A⁰).mp (hT hx)
    let b : G := ⟨y, Algebra.subset_adjoin (hT' hy)⟩
    refine ⟨algebraMap A G a * b, J.mul_mem_right b (Ideal.mem_map_of_mem _ ha), ?_⟩
    change G.val (algebraMap A G a * b) = z
    rw [map_mul, G.val.commutes, hxa]
    exact hxy
  have hOneL : (1 : K) ∈ L := hLe hSpan
  obtain ⟨v, hv, hval⟩ := hOneL
  have hv₁ : v = (1 : G) := by
    apply Subtype.val_injective
    exact hval
  exact Ideal.eq_top_of_isUnit_mem J (hv₁ ▸ hv) isUnit_one

end
end ManuscriptAudit.DedekindInverseIdealAlgebra

open Lean Elab Command in
run_cmd do
  let allowed : List Name := [``propext, ``Classical.choice, ``Quot.sound]
  for name in [``ManuscriptAudit.DedekindInverseIdealAlgebra.exists_numerator,
      ``ManuscriptAudit.DedekindInverseIdealAlgebra.map_eq_top] do
    let dependencies ← collectAxioms name
    let unexpected := dependencies.filter fun axiomName => !allowed.contains axiomName
    unless unexpected.isEmpty do
      throwError m!"{name} depends on unexpected axioms {unexpected}"
    logInfo m!"{name} uses {dependencies}"

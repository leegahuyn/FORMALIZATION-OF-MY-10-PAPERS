import Lean.Util.CollectAxioms
import PrimalitySheafVerification.ManuscriptAudit.ArithmeticLineModel
import PrimalitySheafVerification.ManuscriptAudit.CuspScheme
import PrimalitySheafVerification.ManuscriptAudit.IntegralCuspNodalAffine

/-! The actual arithmetic cusp fiber is one-dimensional, and its coefficient
morphism is supported at the prime (5) of Spec ℤ. -/

namespace ManuscriptAudit.IntegralCuspFiberDimension

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits

noncomputable section

set_option backward.defeqAttrib.useBackward true
set_option backward.isDefEq.respectTransparency false

private abbrev A (K : Type) [Field K] := CuspPunctured.CuspSubalgebra K

/-- The dimension calculation concerns the whole cusp, including its singular point. -/
theorem coordinate_ring_dimension (K : Type) [Field K] : ringKrullDim (A K) = 1 := by
  have h : IsHomeomorph (CuspScheme.cuspMap K) :=
    MorphismProperty.universally_le (topologically @IsHomeomorph) _
      (CuspScheme.paper2_cusp_universal_homeomorphism K)
  have hDim := h.topologicalKrullDim_eq (CuspScheme.cuspMap K)
  change topologicalKrullDim (PrimeSpectrum (Polynomial K)) =
    topologicalKrullDim (PrimeSpectrum (A K)) at hDim
  rw [PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim,
    PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim,
    ArithmeticLineModel.fiber_coordinate_dimension K] at hDim
  exact hDim.symm

/-- Every actual coefficient-field pullback of the flat integer cusp is a curve. -/
theorem fiber_dimension (K : Type) [Field K] :
    topologicalKrullDim (pullback (IntegralCuspNodalAffine.coefficientPoint K)
      IntegralCuspNodalAffine.cuspToInt : Scheme.{0}) = 1 := by
  let e := IntegralCuspNodalAffine.cuspFiberIso K
  have hDim := e.hom.homeomorph.isHomeomorph.topologicalKrullDim_eq e.hom.homeomorph
  change topologicalKrullDim
    (pullback (IntegralCuspNodalAffine.coefficientPoint K) IntegralCuspNodalAffine.cuspToInt :
      Scheme.{0}) = topologicalKrullDim (PrimeSpectrum (A K)) at hDim
  exact hDim.trans (PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim.trans
    (coordinate_ring_dimension K))

private abbrev F₅ := ZMod 5
local instance : Fact (Nat.Prime 5) := ⟨by decide⟩

/-- The unique point of the coefficient scheme maps to the ideal generated by 5. -/
theorem coefficientPoint_five_ideal :
    (IntegralCuspNodalAffine.coefficientPoint F₅ (⊥ : PrimeSpectrum F₅)).asIdeal =
      Ideal.span ({5} : Set ℤ) := by
  change RingHom.ker (algebraMap ℤ F₅) = _
  exact ArithmeticLineModel.residueMap_kernel

end
end ManuscriptAudit.IntegralCuspFiberDimension

open Lean Elab Command in
run_cmd do
  let allowed : List Name := [``propext, ``Classical.choice, ``Quot.sound]
  for name in [``ManuscriptAudit.IntegralCuspFiberDimension.coordinate_ring_dimension,
      ``ManuscriptAudit.IntegralCuspFiberDimension.fiber_dimension,
      ``ManuscriptAudit.IntegralCuspFiberDimension.coefficientPoint_five_ideal] do
    let dependencies ← collectAxioms name
    let unexpected := dependencies.filter fun axiomName => !allowed.contains axiomName
    unless unexpected.isEmpty do
      throwError m!"{name} depends on unexpected axioms {unexpected}"
    logInfo m!"{name} uses {dependencies}"
